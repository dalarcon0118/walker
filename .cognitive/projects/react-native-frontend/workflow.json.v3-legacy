{
  "version": "3.0",
  "description": "Workflow v3 para react-native-frontend. 14 estados con roles PO, Dev, QA.",
  "initial_state": "INIT",
  "nodes": {
    "INIT": {
      "label": "Entrada",
      "description": "El skill acaba de arrancar. No hay sesion activa.",
      "entry_action": null,
      "auto_execute": false
    },
    "CHECK_SPRINTS": {
      "label": "Verificar sprints",
      "description": "Ejecuta spring.py list y evalua gate automaticamente.",
      "entry_action": "python3 .claude/skills/delta/scripts/spring.py list",
      "auto_execute": true,
      "post_gate": {
        "script": "python3 .claude/skills/delta/scripts/delta-gate-check.py sprint-count <chain>",
        "output_to_gate": {
          "0": "no_sprints"
        },
        "auto_transition": false
      },
      "gate_validation": {
        "sprint_selected": {
          "script": "python3 .claude/skills/delta/scripts/delta-gate-check.py sprint-count <chain>",
          "valid_exit": [
            0
          ],
          "error_message": "No hay sprints disponibles. Usa 'no_sprints' gate."
        }
      }
    },
    "CREATE_SPRINT": {
      "label": "Crear sprint",
      "description": "Crea un sprint nuevo. Requiere goal, project-id, y array de tareas.",
      "entry_action": "python3 .claude/skills/delta/scripts/spring.py create <chain> --project-id <id> --goal '...' --tasks '[...]'",
      "auto_execute": false
    },
    "SPRINT_ACTIVE": {
      "label": "Dashboard sprint",
      "description": "Workflow activo. El engine evalua tareas automaticamente.",
      "entry_action": "python3 .claude/skills/delta/scripts/spring.py status <chain>",
      "auto_execute": true,
      "post_gate": {
        "script": "python3 .claude/skills/delta/scripts/delta-gate-check.py pending-count <chain>",
        "output_to_gate": {
          "0": "all_done"
        },
        "auto_transition": false
      },
      "gate_validation": {
        "has_pending": {
          "script": "python3 .claude/skills/delta/scripts/delta-gate-check.py pending-count <chain>",
          "valid_exit": [
            1
          ],
          "error_message": "No hay tareas pendientes. Usa 'all_done' gate."
        },
        "all_done": {
          "script": "python3 .claude/skills/delta/scripts/delta-gate-check.py pending-count <chain>",
          "valid_exit": [
            0
          ],
          "error_message": "Aun hay tareas pendientes. Usa 'has_pending' gate."
        }
      }
    },
    "TASK_PENDING": {
      "label": "Evaluar tarea",
      "description": "Determina que accion tomar. Prioridad: 1) contexto, 2) PO, 3) implementar.",
      "entry_action": null,
      "auto_execute": false,
      "on_entry_message": "Evalua la tarea actual:\n  PASO 1: ?Tiene las 6 capas de contexto?\n    Si NO: transition research_needed\n  PASO 2: ?PO necesita aprobar alcance?\n    Si SI: transition po_needed\n  PASO 3: ?Contexto completo y PO no necesario?\n    transition ready (auditar motivo de omitir PO)",
      "gate_validation": {
        "ready": {
          "script": "python3 .claude/skills/delta/scripts/task.py check-readiness <chain> <task_id>",
          "valid_exit": [
            0
          ],
          "error_message": "Tarea no lista. Motivo: $stderr"
        },
        "research_needed": {
          "script": "python3 .claude/skills/delta/scripts/task.py check-context-gaps <chain> <task_id>",
          "valid_exit": [
            0
          ],
          "error_message": "No se detectaron gaps. Usa 'ready' o 'po_needed'."
        }
      }
    },
    "ANALYSIS_GATE": {
      "label": "Analisis 3-capas",
      "description": "Analisis recursivo 3-capas Q1-A1-Q2-A2-Q3-A3 antes de implementar.",
      "entry_action": null,
      "auto_execute": false,
      "on_entry_message": "ESTAS EN ANALYSIS_GATE — Ejecuta el analisis 3-capas:\n  Q1: ?Que implica implementar esta tarea?\n  Q2: (derivada de Q1)\n  Q3: (derivada de Q2)\n  Si gaps → transition analysis_gap | Si completo → transition analysis_ok",
      "gate_validation": {
        "analysis_ok": {
          "script": "python3 .claude/skills/delta/scripts/task.py check-analysis <chain> <task_id>",
          "valid_exit": [
            0
          ],
          "error_message": "El analisis 3-capas no esta completo o no paso validacion."
        }
      },
      "data_contract": {
        "fields": [
          "q1",
          "a1",
          "q2",
          "a2",
          "q3",
          "a3"
        ],
        "description": "Analisis 6->3 capas"
      }
    },
    "PO_REVIEW": {
      "label": "PO Scope Review",
      "description": "Revisa el alcance (objective + predicates de negocio). NO evalua contexto tecnico.",
      "entry_action": null,
      "auto_execute": false,
      "on_entry_message": "Actua como PO. Revisa el ALCANCE (NO el contexto tecnico):\n  1. ?El objective esta alineado con la vision del producto?\n  2. ?Los predicates de negocio capturan lo que necesito?\n  3. ?Es la prioridad correcta?\n\n  Si NECESITAS contexto:\n    transition po_needs_context --feedback \"que necesito\" (va a RESEARCH y vuelve)\n\n  Si el alcance es correcto:\n    transition po_approved [--feedback \"...\"]\n    transition po_approved_advance [--feedback \"...\"] (atajo si analisis ya listo)\n\n  Si el alcance no es correcto:\n    transition po_rejected --feedback \"razon\"",
      "data_contract": {
        "fields": [
          "feedback"
        ],
        "description": "Opcional: --feedback 'razon de la decision'"
      }
    },
    "RESEARCH": {
      "label": "Investigar contexto",
      "description": "Ejecuta task.py research para generar las 6 capas de contexto.",
      "entry_action": "python3 .claude/skills/delta/scripts/task.py research <chain> <task_id>",
      "auto_execute": true
    },
    "ADVANCE_TASK": {
      "label": "Implementar tarea",
      "description": "Advance con post_gate automatico: OK a DONE_REVIEW o REFINE.",
      "entry_action": "python3 .claude/skills/delta/scripts/task.py advance <chain> <task_id>",
      "auto_execute": true,
      "post_gate": {
        "script": "python3 .claude/skills/delta/scripts/delta-gate-check.py pending-count <chain>",
        "output_to_gate": {
          "0": "report_ready",
          "1": "advance_refine"
        },
        "auto_transition": true
      }
    },
    "VERIFY": {
      "label": "QA Review",
      "description": "Actua como QA/Tester. Revisa la implementacion contra predicates.",
      "entry_action": null,
      "auto_execute": false,
      "on_entry_message": "Actua como QA/Tester. Verifica:\n  1. ?La implementacion satisface los predicates?\n  2. ?El codigo es correcto y sigue los estandares?\n  3. ?Las pruebas pasaron (qlty)?\n  4. ?No hay regresiones?\n  Decide: verify_ok (aprobado) o verify_fail (rechazar con feedback)",
      "data_contract": {
        "fields": [
          "notes"
        ],
        "description": "Notas del QA"
      }
    },
    "REFINE": {
      "label": "Diagnosticar refinamiento",
      "description": "Determina que necesita refinamiento: analisis, contexto, codigo, o PO.",
      "entry_action": null,
      "auto_execute": false,
      "on_entry_message": "Diagnostica que necesita refinamiento:\n  - refine_analysis  -> El analisis fue insuficiente (vuelve a ANALYSIS_GATE)\n  - refine_context   -> Falta contexto (vuelve a RESEARCH)\n  - refine_code      -> La implementacion tiene errores (vuelve a ADVANCE_TASK)\n  - refine_po        -> El PO rechazo (vuelve a PO_REVIEW)"
    },
    "CLOSE_CHECK": {
      "label": "Verificar cierre",
      "description": "Health check con post_gate automatico.",
      "entry_action": "python3 .claude/skills/delta/scripts/spring.py health <chain>",
      "auto_execute": true,
      "post_gate": {
        "script": "python3 .claude/skills/delta/scripts/delta-gate-check.py health-score <chain>",
        "output_to_gate": {
          "1": "health_ok",
          "0": "health_fail"
        },
        "auto_transition": true
      }
    },
    "CLOSE_SPRINT": {
      "label": "Cerrar sprint",
      "description": "Ejecuta spring.py close con verificacion.",
      "entry_action": "python3 .claude/skills/delta/scripts/spring.py close <chain>",
      "auto_execute": true
    },
    "EDIT_PLAN": {
      "label": "Edit Plan",
      "description": "Agregado por auto-migracion.",
      "entry_action": null,
      "auto_execute": false,
      "data_contract": {
        "fields": [
          "action",
          "task_id",
          "field",
          "value",
          "objective",
          "result_state"
        ],
        "description": "Accion: add-task, update-task, update-goal"
      }
    },
    "HANDLE_PENDING": {
      "label": "Handle Pending",
      "description": "Agregado por auto-migracion.",
      "entry_action": null,
      "auto_execute": false
    },
    "IN_PROGRESS": {
      "label": "In Progress",
      "description": "Agregado por auto-migracion.",
      "entry_action": null,
      "auto_execute": false
    },
    "CODE_REVIEW": {
      "label": "Code Review",
      "description": "Agregado por auto-migracion.",
      "entry_action": null,
      "auto_execute": false
    },
    "PO_ACCEPTANCE": {
      "label": "Po Acceptance",
      "description": "Agregado por auto-migracion.",
      "entry_action": null,
      "auto_execute": false
    },
    "ANALYSIS_REVIEW": {
      "label": "Analysis Review",
      "description": "Agregado por auto-migracion.",
      "entry_action": null,
      "auto_execute": false
    },
    "DONE_REVIEW": {
      "label": "Done Review",
      "description": "Agregado por auto-migracion.",
      "entry_action": null,
      "auto_execute": false
    },
    "USER_GATE": {
      "label": "User Gate",
      "description": "Gate de decision del usuario antes de implementar. El workflow se detiene hasta que el usuario decida.",
      "entry_action": null,
      "auto_execute": false,
      "role": "User",
      "context_hint": "Presenta el informe de analisis al usuario. Espera decision: PROCEED, REFINE (con observaciones), o CANCEL.",
      "data_contract": {
        "fields": [
          "notes",
          "reason"
        ],
        "description": "--notes para observaciones de refine, --reason para motivo de cancel"
      },
      "on_entry_message": "INFORME DE TAREA (PRE-IMPLEMENTACION)\n\nPresenta al usuario:\n  1. Task ID + Objective\n  2. Task context resumido (6 capas)\n  3. Analisis 6->3 capas\n  4. Predicates a satisfacer + archivos a modificar\n  5. Riesgos identificados\n\nOpciones del usuario:\n  transition proceed            -> PROCEDER: implementar\n  transition refine --notes X   -> REFINAR: actua como PO, aplica observaciones X, va a PO_REVIEW\n  transition cancel --reason X  -> CANCELAR: descarta tarea, vuelve al sprint"
    },
    "REPORT_GATE": {
      "label": "Report Gate",
      "description": "Gate de decision del usuario post-implementacion. El workflow se detiene hasta que el usuario decida.",
      "entry_action": null,
      "auto_execute": false,
      "role": "User",
      "context_hint": "Presenta el informe de implementacion al usuario. Espera decision: PROCEED, REFINE (con observaciones), o CANCEL.",
      "data_contract": {
        "fields": [
          "notes",
          "reason"
        ],
        "description": "--notes para observaciones de refine, --reason para motivo de cancel"
      },
      "gate_validation": {
        "proceed": {
          "script": "python3 .claude/skills/delta/scripts/delta-gate-check.py check-dependencies <chain> <task_id>",
          "valid_exit": [
            0
          ],
          "error_message": "Tarea $task_id tiene dependencias no resueltas: $stderr"
        }
      },
      "on_entry_message": "INFORME DE IMPLEMENTACION (POST-IMPLEMENTACION)\n\nPresenta al usuario:\n  1. Task ID + Objective + Result State\n  2. QUE se hizo (archivos modificados, simbolos creados/eliminados)\n  3. POR QUE se hizo asi (decisiones de implementacion)\n  4. Predicates verificados vs resultado real\n  5. Riesgos remanentes\n\nOpciones del usuario:\n  transition proceed            -> PROCEDER: pasar a QA verification\n  transition refine --notes X   -> REFINAR: actua como PO, ajusta criterios, va a PO_REVIEW\n  transition cancel --reason X  -> CANCELAR: descarta tarea, vuelve al sprint"
    }
  },
  "edges": [
    {
      "from": "INIT",
      "to": "CHECK_SPRINTS",
      "gate": null,
      "description": "Arranca el flujo del skill."
    },
    {
      "from": "CHECK_SPRINTS",
      "to": "CREATE_SPRINT",
      "gate": "no_sprints",
      "description": "No hay sprints. Crear uno nuevo.",
      "auto": true
    },
    {
      "from": "CHECK_SPRINTS",
      "to": "SPRINT_ACTIVE",
      "gate": "sprint_selected",
      "description": "Sprints existen.",
      "auto": true
    },
    {
      "from": "CREATE_SPRINT",
      "to": "SPRINT_ACTIVE",
      "gate": "creation_ok",
      "description": "Sprint creado."
    },
    {
      "from": "SPRINT_ACTIVE",
      "to": "TASK_PENDING",
      "gate": "has_pending",
      "description": "Hay tareas no completadas.",
      "auto": true
    },
    {
      "from": "SPRINT_ACTIVE",
      "to": "CLOSE_CHECK",
      "gate": "all_done",
      "description": "Todas las tareas completadas.",
      "auto": true
    },
    {
      "from": "TASK_PENDING",
      "to": "PO_REVIEW",
      "gate": "po_needed",
      "description": "PO approval necesario."
    },
    {
      "from": "TASK_PENDING",
      "to": "RESEARCH",
      "gate": "research_needed",
      "description": "Falta contexto o hay gaps."
    },
    {
      "from": "ANALYSIS_GATE",
      "to": "RESEARCH",
      "gate": "analysis_gap",
      "description": "Falta contexto. Investigar mas."
    },
    {
      "from": "PO_REVIEW",
      "to": "TASK_PENDING",
      "gate": "po_approved",
      "description": "PO aprobo. Volver a evaluar."
    },
    {
      "from": "PO_REVIEW",
      "to": "TASK_PENDING",
      "gate": "po_rejected",
      "description": "PO rechazo. Revisar feedback."
    },
    {
      "from": "PO_REVIEW",
      "to": "RESEARCH",
      "gate": "po_needs_context",
      "description": "PO necesita contexto tecnico antes de decidir. RESEARCH genera las 6 capas y vuelve."
    },
    {
      "from": "ADVANCE_TASK",
      "to": "REFINE",
      "gate": "advance_refine",
      "description": "Tarea pendiente. Diagnosticar.",
      "auto": true
    },
    {
      "from": "VERIFY",
      "to": "SPRINT_ACTIVE",
      "gate": "verify_ok",
      "description": "QA aprobo. Tarea completada."
    },
    {
      "from": "VERIFY",
      "to": "REFINE",
      "gate": "verify_fail",
      "description": "QA rechazo. Diagnosticar."
    },
    {
      "from": "REFINE",
      "to": "ANALYSIS_GATE",
      "gate": "refine_analysis",
      "description": "Refinar analisis."
    },
    {
      "from": "REFINE",
      "to": "RESEARCH",
      "gate": "refine_context",
      "description": "Refinar contexto."
    },
    {
      "from": "REFINE",
      "to": "ADVANCE_TASK",
      "gate": "refine_code",
      "description": "Refinar implementacion."
    },
    {
      "from": "REFINE",
      "to": "PO_REVIEW",
      "gate": "refine_po",
      "description": "Revisar con PO."
    },
    {
      "from": "CLOSE_CHECK",
      "to": "CLOSE_SPRINT",
      "gate": "health_ok",
      "description": "Health > 80. Cerrar.",
      "auto": true
    },
    {
      "from": "CLOSE_CHECK",
      "to": "SPRINT_ACTIVE",
      "gate": "health_fail",
      "description": "Health <= 80. Resolver.",
      "auto": true
    },
    {
      "from": "CLOSE_SPRINT",
      "to": "INIT",
      "gate": null,
      "description": "Sprint cerrado. Volver al inicio."
    },
    {
      "from": "SPRINT_ACTIVE",
      "to": "EDIT_PLAN",
      "gate": "edit_plan",
      "description": "Agregado por auto-migracion.",
      "auto": true
    },
    {
      "from": "EDIT_PLAN",
      "to": "SPRINT_ACTIVE",
      "gate": "plan_updated",
      "description": "Agregado por auto-migracion."
    },
    {
      "from": "CLOSE_CHECK",
      "to": "HANDLE_PENDING",
      "gate": "handle_pending",
      "description": "Agregado por auto-migracion.",
      "auto": true
    },
    {
      "from": "HANDLE_PENDING",
      "to": "CLOSE_SPRINT",
      "gate": "backlog",
      "description": "Agregado por auto-migracion."
    },
    {
      "from": "HANDLE_PENDING",
      "to": "CLOSE_SPRINT",
      "gate": "cancel_pending",
      "description": "Agregado por auto-migracion."
    },
    {
      "from": "HANDLE_PENDING",
      "to": "SPRINT_ACTIVE",
      "gate": "defer",
      "description": "Agregado por auto-migracion."
    },
    {
      "from": "TASK_PENDING",
      "to": "IN_PROGRESS",
      "gate": "ready",
      "description": "Agregado por auto-migracion."
    },
    {
      "from": "IN_PROGRESS",
      "to": "RESEARCH",
      "gate": "research_needed",
      "description": "Agregado por auto-migracion."
    },
    {
      "from": "IN_PROGRESS",
      "to": "ANALYSIS_GATE",
      "gate": "ready",
      "description": "Agregado por auto-migracion."
    },
    {
      "from": "RESEARCH",
      "to": "IN_PROGRESS",
      "gate": null,
      "description": "Agregado por auto-migracion."
    },
    {
      "from": "RESEARCH",
      "to": "PO_REVIEW",
      "gate": "po_context_ready",
      "description": "Contexto listo. Volver a PO_REVIEW para que decida con las 6 capas."
    },
    {
      "from": "CODE_REVIEW",
      "to": "ADVANCE_TASK",
      "gate": "review_fail",
      "description": "Agregado por auto-migracion."
    },
    {
      "from": "PO_ACCEPTANCE",
      "to": "SPRINT_ACTIVE",
      "gate": "po_accepted",
      "description": "Agregado por auto-migracion."
    },
    {
      "from": "PO_ACCEPTANCE",
      "to": "ADVANCE_TASK",
      "gate": "po_reject",
      "description": "Agregado por auto-migracion."
    },
    {
      "from": "PO_REVIEW",
      "to": "ADVANCE_TASK",
      "gate": "po_approved_advance",
      "description": "Agregado por auto-migracion."
    },
    {
      "from": "RESEARCH",
      "to": "ANALYSIS_GATE",
      "gate": "ready",
      "description": "Agregado por auto-migracion."
    },
    {
      "from": "ANALYSIS_GATE",
      "to": "ANALYSIS_REVIEW",
      "gate": "analysis_ok",
      "description": "Agregado por auto-migracion."
    },
    {
      "from": "ANALYSIS_REVIEW",
      "to": "RESEARCH",
      "gate": "analysis_gap",
      "description": "Agregado por auto-migracion."
    },
    {
      "from": "DONE_REVIEW",
      "to": "CODE_REVIEW",
      "gate": "report_approved",
      "description": "Agregado por auto-migracion."
    },
    {
      "from": "DONE_REVIEW",
      "to": "REFINE",
      "gate": "advance_refine",
      "description": "Agregado por auto-migracion."
    },
    {
      "from": "ADVANCE_TASK",
      "to": "DONE_REVIEW",
      "gate": "report_ready",
      "description": "Implementacion lista. Revisar informe.",
      "auto": true
    },
    {
      "from": "ANALYSIS_REVIEW",
      "to": "USER_GATE",
      "gate": "advance_confirm",
      "description": "Agregado por auto-migracion."
    },
    {
      "from": "USER_GATE",
      "to": "ADVANCE_TASK",
      "gate": "proceed",
      "description": "Agregado por auto-migracion."
    },
    {
      "from": "USER_GATE",
      "to": "PO_REVIEW",
      "gate": "refine",
      "description": "Agregado por auto-migracion."
    },
    {
      "from": "USER_GATE",
      "to": "SPRINT_ACTIVE",
      "gate": "cancel",
      "description": "Agregado por auto-migracion."
    },
    {
      "from": "CODE_REVIEW",
      "to": "REPORT_GATE",
      "gate": "review_ok",
      "description": "Agregado por auto-migracion."
    },
    {
      "from": "REPORT_GATE",
      "to": "VERIFY",
      "gate": "proceed",
      "description": "Agregado por auto-migracion."
    },
    {
      "from": "REPORT_GATE",
      "to": "PO_REVIEW",
      "gate": "refine",
      "description": "Agregado por auto-migracion."
    },
    {
      "from": "REPORT_GATE",
      "to": "SPRINT_ACTIVE",
      "gate": "cancel",
      "description": "Agregado por auto-migracion."
    },
    {
      "from": "VERIFY",
      "to": "PO_ACCEPTANCE",
      "gate": "verify_ok",
      "description": "Agregado por auto-migracion."
    }
  ]
}