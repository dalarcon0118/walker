{
  "label": "Task Analysis",
  "description": "Task investigation, analysis, and approval before implementation.",
  "provides": [
    "analysis_summary"
  ],
  "sub_states": [
    {
      "key": "GATHER",
      "label": "Update code index before analysis",
      "execution": "auto",
      "input_schema": {},
      "output_schema": {},
      "on_success": "ANALYZE",
      "on_failure": "",
      "side_effects": [
        {
          "type": "index_code",
          "params": {},
          "optional": true
        }
      ],
      "retry": {
        "max_attempts": 2,
        "backoff": "exponential",
        "initial_delay_ms": 2000
      },
      "timeout_ms": 120000,
      "prompt_id": "analyze/gather",
      "audit": {
        "capture_stdout": true,
        "capture_stderr": true,
        "level": "normal"
      },
      "context": {
        "budget": {
          "max_tokens": 80000,
          "reserve_for_response": 10000,
          "strategy": "truncate"
        }
      }
    },
    {
      "key": "ANALYZE",
      "label": "6->3 analysis",
      "execution": "llm_task",
      "needs": [
        "project_id",
        "task_id",
        "sprint_id"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "q1": {
            "type": "string",
            "description": "Question 1 of the 6->3 analysis",
            "examples": [
              "What components currently exist in the code?"
            ]
          },
          "a1": {
            "type": "string",
            "minLength": 10,
            "description": "Answer to question 1",
            "examples": [
              "There are currently 3 main components: A, B, and C"
            ]
          },
          "q2": {
            "type": "string",
            "description": "Question 2 of the 6->3 analysis",
            "examples": [
              "What impact does the task have on each component?"
            ]
          },
          "a2": {
            "type": "string",
            "minLength": 10,
            "description": "Answer to question 2",
            "examples": [
              "The task affects component A because it introduces a new flow"
            ]
          },
          "q3": {
            "type": "string",
            "description": "Question 3 of the 6->3 analysis",
            "examples": [
              "What implementation approach is recommended?"
            ]
          },
          "a3": {
            "type": "string",
            "minLength": 10,
            "description": "Answer to question 3",
            "examples": [
              "Recommended approach: Strategy pattern in the domain layer"
            ]
          }
        },
        "required": [
          "q1",
          "a1",
          "q2",
          "a2",
          "q3",
          "a3"
        ]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "analyzed"
            ],
            "description": "Analysis completed"
          },
          "summary": {
            "type": "string",
            "description": "Analysis summary"
          }
        },
        "description": "6->3 analysis completed. Transitions to REVIEW for approval."
      },
      "on_success": "REVIEW",
      "on_failure": "GATHER",
      "side_effects": [],
      "retry": {
        "max_attempts": 3,
        "backoff": "exponential",
        "initial_delay_ms": 5000
      },
      "timeout_ms": 300000,
      "prompt_id": "analyze/analyze",
      "context": {
        "sources": [
          {
            "provider": "project",
            "config": {}
          },
          {
            "provider": "task",
            "config": {}
          },
          {
            "provider": "state",
            "config": {
              "query": {}
            }
          },
          {
            "provider": "ckg",
            "config": {
              "query": {
                "type": "decision"
              },
              "max_nodes": 15
            }
          },
          {
            "provider": "cpg",
            "config": {
              "query": {
                "file": "features"
              },
              "max_results": 20
            }
          },
          {
            "provider": "trace",
            "config": {
              "max_events": 5
            }
          }
        ],
        "focus": {
          "role": "analyzing task {task_id} for sprint \"{sprint_goal}\"",
          "constraints": [
            "Base your architecture analysis on CKG patterns + CPG code structure",
            "Consider each architectural layer (domain, application, infrastructure) when assessing impact"
          ],
          "context_priority": "project \u2192 task \u2192 ckg \u2192 cpg \u2192 state \u2192 trace"
        },
        "budget": {
          "max_tokens": 80000,
          "reserve_for_response": 10000,
          "strategy": "truncate"
        }
      },
      "audit": {
        "level": "normal"
      }
    },
    {
      "key": "REVIEW",
      "label": "Review analysis",
      "execution": "user_input",
      "input_schema": {},
      "output_schema": {
        "type": "object",
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "reject"
            ],
            "description": "PO decision on analysis and knowledge"
          },
          "evidence": {
            "type": "string",
            "description": "PO feedback"
          },
          "knowledge_items": {
            "type": "array",
            "description": "Knowledge captured during review (lessons/patterns)",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "decision"
        ],
        "description": "Analysis + knowledge reviewed. approve -> KNOWLEDGE_CAPTURE (auto) -> IMPLEMENT."
      },
      "on_success": "KNOWLEDGE_CAPTURE",
      "on_failure": "GATHER",
      "side_effects": [
        {
          "type": "capture_decision",
          "params": {}
        }
      ],
      "timeout_ms": 600000,
      "prompt_id": "analyze/review",
      "context": {
        "sources": [
          {
            "provider": "project",
            "config": {}
          },
          {
            "provider": "task",
            "config": {}
          },
          {
            "provider": "state",
            "config": {
              "query": {}
            }
          }
        ],
        "focus": {
          "role": "reviewing analysis results for task {task_id}",
          "constraints": [
            "Present the 6->3 analysis summary from the STATE layer",
            "Show task objective, impacted files, and risks from TASK layer",
            "Show project conventions from PROJECT layer for context",
            "Ask user to approve or reject the analysis"
          ],
          "context_priority": "project \u2192 task \u2192 state"
        },
        "budget": {
          "max_tokens": 80000,
          "reserve_for_response": 10000,
          "strategy": "truncate"
        }
      },
      "audit": {
        "capture_decision": true,
        "capture_evidence": true,
        "level": "full"
      }
    },
    {
      "key": "KNOWLEDGE_CAPTURE",
      "label": "Capture knowledge",
      "execution": "llm_task",
      "input_schema": {
        "type": "object",
        "properties": {
          "artefactos": {
            "type": "array",
            "description": "Artifacts generated during analysis (diagrams, documents, files)",
            "items": {
              "type": "object",
              "properties": {
                "nombre": {
                  "type": "string",
                  "description": "Artifact name"
                },
                "tipo": {
                  "type": "string",
                  "description": "Type: diagram, doc, code"
                },
                "descripcion": {
                  "type": "string",
                  "description": "Artifact description"
                }
              }
            },
            "examples": [
              [
                {
                  "nombre": "Component diagram",
                  "tipo": "diagram",
                  "descripcion": "Diagram showing module relationships"
                }
              ]
            ]
          },
          "reglas": {
            "type": "array",
            "description": "Rules extracted from analysis (conventions, patterns, constraints)",
            "items": {
              "type": "object",
              "properties": {
                "regla": {
                  "type": "string",
                  "description": "Rule description"
                },
                "scope": {
                  "type": "string",
                  "description": "Scope: project, module, team"
                },
                "severidad": {
                  "type": "string",
                  "enum": [
                    "obligatoria",
                    "recomendada",
                    "informativa"
                  ]
                }
              }
            },
            "examples": [
              [
                {
                  "regla": "Always use dataclasses for domain models",
                  "scope": "project",
                  "severidad": "obligatoria"
                }
              ]
            ]
          },
          "decisiones": {
            "type": "array",
            "description": "Design decisions made during analysis",
            "items": {
              "type": "object",
              "properties": {
                "decision": {
                  "type": "string",
                  "description": "Decision description"
                },
                "alternativas": {
                  "type": "array",
                  "description": "Alternatives considered"
                },
                "razon": {
                  "type": "string",
                  "description": "Why the decision was made"
                }
              }
            },
            "examples": [
              [
                {
                  "decision": "Use TaskRegistry instead of switch-case",
                  "alternativas": [
                    "switch-case",
                    "strategy pattern"
                  ],
                  "razon": "DRY + extensibility"
                }
              ]
            ]
          },
          "advertencias": {
            "type": "array",
            "description": "Warnings or risks identified",
            "items": {
              "type": "object",
              "properties": {
                "advertencia": {
                  "type": "string",
                  "description": "Warning description"
                },
                "impacto": {
                  "type": "string",
                  "description": "Potential impact"
                },
                "mitigacion": {
                  "type": "string",
                  "description": "How to mitigate the risk"
                }
              }
            },
            "examples": [
              [
                {
                  "advertencia": "Migration may break backward compatibility",
                  "impacto": "high",
                  "mitigacion": "Implement v2 to v3 mapper"
                }
              ]
            ]
          }
        }
      },
      "output_schema": {
        "type": "object",
        "$ref": "../schema/knowledge-capture.schema.json",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "captured"
            ],
            "description": "Knowledge captured"
          },
          "total_items": {
            "type": "integer",
            "description": "Total items captured"
          }
        },
        "description": "Knowledge captured. Referencia schema/knowledge-capture.schema.json (canonico)."
      },
      "on_success": "",
      "on_failure": "REVIEW",
      "side_effects": [
        {
          "type": "documenting_knowledge",
          "params": {},
          "compensation": {
            "type": "delete_ckg_nodes",
            "description": "If transition to next phase fails, rollback captured knowledge"
          }
        },
        {
          "type": "emit_event",
          "params": {
            "event": "knowledge_captured"
          }
        },
        {
          "type": "ckg_status",
          "params": {
            "event": "knowledge_captured"
          },
          "description": "Mark CKG as up_to_date after knowledge capture"
        }
      ],
      "retry": {
        "max_attempts": 2,
        "backoff": "exponential",
        "initial_delay_ms": 3000
      },
      "timeout_ms": 120000,
      "prompt_id": "analyze/knowledge-capture",
      "context": {
        "sources": [
          {
            "provider": "project",
            "config": {}
          },
          {
            "provider": "task",
            "config": {}
          },
          {
            "provider": "state",
            "config": {
              "query": {}
            }
          },
          {
            "provider": "ckg",
            "config": {
              "query": {
                "type": "decision"
              },
              "max_nodes": 10
            }
          },
          {
            "provider": "cpg",
            "config": {
              "max_results": 10
            }
          },
          {
            "provider": "trace",
            "config": {
              "max_events": 5
            }
          }
        ],
        "focus": {
          "role": "extracting knowledge from the analysis of task {task_id} for sprint \"{sprint_goal}\"",
          "constraints": [
            "Check CKG first to see what knowledge already exists \u2014 avoid duplicating existing decisions or patterns",
            "Use CPG to reference specific code structures impacted",
            "Extract artifacts, rules, design decisions, and warnings from the analysis"
          ],
          "context_priority": "project \u2192 task \u2192 ckg \u2192 cpg \u2192 state \u2192 trace"
        },
        "budget": {
          "max_tokens": 80000,
          "reserve_for_response": 10000,
          "strategy": "truncate"
        }
      },
      "audit": {
        "level": "normal"
      }
    }
  ]
}