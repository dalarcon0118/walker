{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schema/project.schema.json",
  "title": "Delta Project Profile",
  "description": "Schema for project.json — perfil completo de un proyecto con preferencias de diseño, arquitectura y codificación",
  "type": "object",
  "required": ["project"],
  "properties": {
    "project": {
      "type": "object",
      "required": ["meta", "identity", "location", "design", "architecture", "coding"],
      "properties": {
        "meta": {
          "type": "object",
          "required": ["project_id", "version", "created_at", "updated_at"],
          "properties": {
            "project_id": {
              "type": "string",
              "description": "Identificador único del proyecto (slug)",
              "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
            },
            "version": { "type": "string", "description": "Versión del schema del project.json", "default": "1.0" },
            "created_at": { "type": "string", "format": "date-time", "description": "ISO timestamp de creación" },
            "updated_at": { "type": "string", "format": "date-time", "description": "ISO timestamp de última modificación" }
          }
        },
        "identity": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "description": "Nombre legible del proyecto" },
            "description": { "type": "string", "description": "Descripción del proyecto" },
            "language": { "type": "string", "description": "Lenguaje principal" },
            "framework": { "type": "string", "description": "Framework principal" },
            "tags": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Tags del proyecto (mcp, cognitive, ddd, etc.)"
            }
          }
        },
        "location": {
          "type": "object",
          "required": ["repo_path"],
          "properties": {
            "repo_path": { "type": "string", "description": "Ruta absoluta al repositorio del proyecto" },
            "cognitive_subdir": { "type": "string", "description": "Subdirectorio dentro del repo donde está .cognitive (si aplica)", "default": "" },
            "code_paths": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Directorios de código fuente (relativos a repo_path)"
            }
          }
        },
        "design": {
          "type": "object",
          "description": "Preferencias de diseño arquitectónico — definidas por el arquitecto/equipo",
          "properties": {
            "patterns": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Patrones de diseño usados (hexagonal, ddd, cqrs, event-sourcing, etc.)"
            },
            "layer_rules": {
              "type": "object",
              "description": "Reglas de dependencia entre capas",
              "additionalProperties": { "type": "string" },
              "default": {}
            },
            "bounded_contexts": {
              "type": "array",
              "description": "Bounded contexts del proyecto (DDD estratégico)",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "type": { "type": "string", "enum": ["core", "supporting", "generic", "front-door"] },
                  "dependencies": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                },
                "required": ["name"]
              }
            },
            "port_adapter_required": {
              "type": "boolean",
              "description": "Si es obligatorio usar port-adapter pattern entre capas",
              "default": false
            },
            "forbidden_dependencies": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Dependencias prohibidas (ej: infrastructure → domain directo)"
            },
            "decisions": {
              "type": "array",
              "description": "Decisiones arquitectónicas registradas (ADRs)",
              "items": {
                "type": "object",
                "properties": {
                  "adr": { "type": "string" },
                  "title": { "type": "string" },
                  "rationale": { "type": "string" }
                },
                "required": ["adr", "title"]
              }
            }
          }
        },
        "architecture": {
          "type": "object",
          "description": "Preferencias de organización del código y estrategia técnica",
          "properties": {
            "project_structure": {
              "type": "string",
              "description": "Estructura del proyecto (monorepo, multi-repo, flat, etc.)"
            },
            "module_organization": {
              "type": "string",
              "description": "Convención de organización de módulos (features/<bc>/<layer>/, src/<module>/, etc.)"
            },
            "test_strategy": {
              "type": "object",
              "description": "Estrategia de testing",
              "properties": {
                "unit": { "type": "string" },
                "integration": { "type": "string" },
                "e2e": { "type": "string" }
              }
            },
            "dependency_injection": {
              "type": "string",
              "description": "Estrategia de DI (constructor injection, manual, framework DI, etc.)"
            },
            "error_handling": {
              "type": "string",
              "description": "Estrategia de manejo de errores (result types, exceptions, etc.)"
            },
            "config_management": {
              "type": "string",
              "description": "Gestión de configuración (env vars, pydantic-settings, yaml, etc.)"
            }
          }
        },
        "coding": {
          "type": "object",
          "description": "Preferencias de codificación — detectables automáticamente o configurables",
          "properties": {
            "language": { "type": "string", "description": "Lenguaje y versión (ej: python 3.12+)" },
            "naming_convention": { "type": "string", "description": "snake_case, camelCase, PascalCase, kebab-case" },
            "formatter": { "type": "string", "description": "Formateador (ruff format, black, prettier, etc.)" },
            "linter": { "type": "string", "description": "Linter (ruff check, pylint, eslint, etc.)" },
            "type_checker": { "type": "string", "description": "Type checker (pyright, mypy, TypeScript, etc.)" },
            "test_framework": { "type": "string", "description": "Framework de tests (pytest, jest, vitest, etc.)" },
            "import_style": { "type": "string", "description": "absolute imports, relative imports" },
            "docstring_style": { "type": "string", "description": "google, numpy, sphinx, jsdoc, etc." },
            "max_line_length": { "type": "integer", "description": "Máximo de caracteres por línea", "default": 100 },
            "git_workflow": {
              "type": "object",
              "properties": {
                "branch_naming": { "type": "string" },
                "commit_convention": { "type": "string" },
                "pr_style": { "type": "string" }
              }
            }
          }
        },
        "quality_preferences": {
          "type": "object",
          "description": "Thresholds de calidad personalizados (sobrescriben los defaults del skill)",
          "properties": {
            "cyclo_max": { "type": "integer", "default": 60 },
            "lcom_max": { "type": "integer", "default": 20 },
            "ce_max": { "type": "integer", "default": 10 },
            "cc_per_func_max": { "type": "integer", "default": 15 },
            "dup_blocks_max": { "type": "integer", "default": 2 },
            "security_high_max": { "type": "integer", "default": 0 },
            "hallucinated_imports_max": { "type": "integer", "default": 0 },
            "coverage_min": { "type": ["number", "null"], "default": null }
          }
        },
        "active_goal": {
          "type": "object",
          "description": "Objetivo activo del proyecto (delta en curso)",
          "properties": {
            "description": { "type": "string" },
            "chain_id": { "type": "string" },
            "set_at": { "type": "string", "format": "date-time" }
          }
        },
        "goals_history": {
          "type": "array",
          "description": "Historial de objetivos completados",
          "items": {
            "type": "object",
            "properties": {
              "chain_id": { "type": "string" },
              "description": { "type": "string" },
              "closed_at": { "type": "string", "format": "date-time" },
              "outcome": { "type": "string", "enum": ["completed", "superseded", "cancelled"] }
            },
            "required": ["chain_id", "description", "closed_at"]
          }
        },
        "team": {
          "type": "object",
          "description": "Información del equipo",
          "properties": {
            "owners": {
              "type": "array",
              "items": { "type": "string" }
            },
            "bounded_contexts": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "dependencies": {
          "type": "object",
          "description": "Dependencias del proyecto",
          "properties": {
            "internal_modules": {
              "type": "array",
              "items": { "type": "string" }
            },
            "external_services": {
              "type": "array",
              "items": { "type": "string" }
            },
            "related_projects": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "detected_profile": {
          "type": "object",
          "description": "Perfil detectado automáticamente (por ProjectProfileBuilder). No editar manualmente.",
          "default": {}
        }
      }
    }
  }
}
