{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "delta/spring.schema.json",
  "title": "Delta Sprint State",
  "description": "Schema for sprint-state.json — defines sprint lifecycle, planning state, and task definition flow.",
  "type": "object",
  "required": [
    "sprint_id",
    "project_id",
    "state",
    "current_task_id",
    "planning_phase",
    "tasks"
  ],
  "properties": {
    "sprint_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9-]+$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "string",
      "enum": [
        "spring-planning",
        "active",
        "closed",
        "paused"
      ]
    },
    "current_task_id": {
      "type": "string",
      "minLength": 1
    },
    "planning_phase": {
      "type": "string",
      "enum": [
        "task_definition",
        "task_refine",
        "task_pending",
        "next_task"
      ]
    },
    "goal": {
      "type": "string",
      "minLength": 10
    },
    "workflow_state": {
      "type": "object",
      "required": ["current_node", "current_sub_state"],
      "properties": {
        "current_node": {
          "type": "string",
          "minLength": 1
        },
        "current_sub_state": {
          "type": "string",
          "minLength": 1
        },
        "sub_state_index": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task_id", "status"],
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^TASK-[A-Z0-9-]+$"
          },
          "status": {
            "type": "string",
            "enum": ["defined", "pending", "in_progress", "completed"]
          },
          "definition": {
            "type": "object"
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
