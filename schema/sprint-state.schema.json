{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "delta/progress.schema.json",
  "title": "Delta Progress",
  "description": "Schema for delta progress.json — tracks task states, trail, calibration, and closure",
  "type": "object",
  "required": ["progress"],
  "properties": {
    "progress": {
      "type": "object",
      "required": ["meta", "plan_ref", "trail", "current"],
      "properties": {
        "meta": {
          "type": "object",
          "required": ["chain_id", "generated_at", "version", "source", "type"],
          "properties": {
            "chain_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
            "generated_at": { "type": "string", "format": "date-time" },
            "version": { "type": "string" },
            "source": { "type": "string", "enum": ["delta-skill"] },
            "type": { "type": "string", "enum": ["progress"] },
            "status": { "type": "string", "enum": ["active", "closed", "suspended", "pending"] }
          }
        },
        "plan_ref": { "type": "string" },
        "trail": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trail_entry"
          }
        },
        "current": {
          "type": "object",
          "required": ["task_states"],
          "properties": {
            "task_states": {
              "type": "object",
              "description": "Mapa task_id → estado. Máquina de estados: pending → in_progress → ready_for_review → completed. SOLO la tarea en current.next_action puede estar en 'in_progress'. Las transiciones las ejecuta delta-advance.py, que aplica el gate de enforcement (scripts/delta-enforce.py: next_action-match, curvature_budget, distance_guard, backlog_required). Editar task_states fuera de delta-advance.py viola este contrato.",
              "additionalProperties": {
                "type": "string",
                "enum": ["pending", "in_progress", "ready_for_review", "completed"]
              }
            },
            "next_action": { "$ref": "#/$defs/next_action" },
            "alternatives": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "task_id": { "type": "string" },
                  "role": { "type": "string" },
                  "objective": { "type": "string" },
                  "score": { "type": "number" },
                  "rationale": { "type": "string" }
                }
              }
            },
            "risks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "description": { "type": "string" },
                  "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
                  "affected": { "type": "string" }
                }
              }
            },
            "finished": { "type": "boolean" },
            "closure": { "$ref": "#/$defs/closure_data" },
            "model": {
              "type": "object",
              "properties": {
                "history": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "task_id": { "type": "string" },
                      "error_type": { "type": "string" },
                      "error_pct": { "type": "number" },
                      "cause_category": { "type": "string" },
                      "learnable": { "type": "boolean" },
                      "learnings": { "type": "array", "items": { "type": "string" } },
                      "adjustments": { "type": "array", "items": { "type": "object" } }
                    }
                  }
                },
                "parameters": {
                  "type": "object",
                  "additionalProperties": { "type": "number" }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "trail_entry": {
      "type": "object",
      "required": ["at", "distance", "event"],
      "properties": {
        "at": { "type": "string", "format": "date-time" },
        "distance": { "type": "number", "minimum": 0, "maximum": 1 },
        "predicates_satisfied": { "type": "string" },
        "tasks_completed": { "type": "array", "items": { "type": "string" } },
        "event": { "type": "string" },
        "tasks": { "type": "array", "items": { "type": "string" } },
        "loop": { "$ref": "#/$defs/loop_data" },
        "calibration": { "$ref": "#/$defs/calibration_data" },
        "closure": { "$ref": "#/$defs/closure_data" }
      }
    },
    "next_action": {
      "oneOf": [
        {
          "type": "object",
          "required": ["task_id", "candidate", "type", "work_type", "target", "delta", "confidence", "risk", "score", "rationale"],
          "properties": {
            "task_id": { "type": "string" },
            "role": { "type": "string" },
            "candidate": { "type": "string" },
            "type": { "type": "string" },
            "work_type": { "type": "string" },
            "target": { "type": "string" },
            "delta": { "type": "number" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "risk": { "type": "number", "minimum": 0, "maximum": 1 },
            "score": { "type": "number", "minimum": 0, "maximum": 1 },
            "rationale": { "type": "string" }
          }
        },
        { "type": "null" }
      ]
    },
    "loop_data": {
      "type": "object",
      "required": ["result_state", "acceptance", "checks"],
      "properties": {
        "result_state": { "type": "string" },
        "acceptance": { "type": "boolean" },
        "acceptance_mode": { "type": "string", "enum": ["all", "critical_only"] },
        "checks": {
          "type": "object",
          "required": ["total", "passed"],
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "passed": { "type": "integer", "minimum": 0 },
            "failed": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "predicate": { "type": "string" },
                  "type": { "type": "string", "enum": ["must_exist", "must_not_exist", "test"] },
                  "verification": { "type": "string" },
                  "actual": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "calibration_data": {
      "type": "object",
      "properties": {
        "state": {
          "type": "object",
          "properties": {
            "expected_satisfied": { "type": "integer" },
            "actual_satisfied": { "type": "integer" },
            "type": { "type": "string", "enum": ["accurate", "over_estimated", "under_estimated"] },
            "gap_detail": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "predicate": { "type": "string" },
                  "expected": { "type": "boolean" },
                  "actual": { "type": "boolean" },
                  "cause": { "type": "string" }
                }
              }
            }
          }
        },
        "delta": {
          "type": "object",
          "properties": {
            "expected_reduction": { "type": "number" },
            "actual_reduction": { "type": "number" },
            "error": { "type": "number" },
            "error_pct": { "type": "number" },
            "error_type": { "type": "string" },
            "cause": {
              "type": "object",
              "properties": {
                "category": { "type": "string", "enum": ["external", "reasoning", "execution", "environment", "unknown"] },
                "evidence": { "type": "string" },
                "learnable": { "type": "boolean" },
                "contributors": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        },
        "strategy": {
          "type": "object",
          "properties": {
            "optimal": { "type": "boolean" }
          }
        }
      }
    },
    "closure_data": {
      "type": "object",
      "properties": {
        "composicion_valida": { "type": "boolean" },
        "full_rescan_executed": { "type": "boolean" },
        "side_effects_detected": { "type": "integer", "minimum": 0 },
        "side_effects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "predicate": { "type": "string" },
              "satisfied_by": { "type": "string" },
              "detected_at": { "type": "string", "format": "date-time" }
            }
          }
        },
        "model_corrections": { "type": "array", "items": { "type": "string" } },
        "total_tasks": { "type": "integer", "minimum": 0 },
        "total_advances": { "type": "integer", "minimum": 0 },
        "total_distance_traveled": { "type": "string" },
        "next_delta_candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "domain": { "type": "string" },
              "description": { "type": "string" },
              "source": { "type": "string" },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "rationale": { "type": "string" },
              "predicates_suggested": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
