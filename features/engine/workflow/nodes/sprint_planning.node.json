{
  "label": "Sprint planning",
  "description": "Planificacion de sprints: definicion de goal, tareas y validacion.",
  "sub_states": [
    {
      "key": "GOAL",
      "label": "Define sprint goal",
      "execution": "llm_task",
      "input_schema": {
        "type": "object",
        "properties": {
          "goal": {
            "type": "string",
            "minLength": 10,
            "description": "Objetivo principal del sprint",
            "examples": [
              "Completar la migraci\u00f3n del workflow engine a DDD"
            ]
          },
          "expected_result": {
            "type": "string",
            "minLength": 10,
            "description": "Resultado esperado al finalizar el sprint",
            "examples": [
              "Workflow engine con capas domain/application/infrastructure, tests pasando"
            ]
          },
          "roles": {
            "type": "object",
            "description": "Roles del equipo para este sprint",
            "properties": {
              "dev": {
                "type": "string",
                "description": "Desarrollador asignado",
                "examples": [
                  "agente"
                ]
              },
              "qa": {
                "type": "string",
                "description": "QA asignado",
                "examples": [
                  "engine"
                ]
              },
              "po": {
                "type": "string",
                "description": "Product Owner",
                "examples": [
                  "usuario"
                ]
              }
            },
            "examples": [
              {
                "dev": "agente",
                "qa": "engine",
                "po": "usuario"
              }
            ]
          }
        },
        "required": [
          "goal"
        ]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "goal_defined"
            ],
            "description": "Goal definido"
          },
          "goal": {
            "type": "string",
            "description": "Goal confirmado"
          }
        },
        "description": "Goal del sprint definido. Transici\u00f3n a ADD_TASKS para agregar tareas."
      },
      "on_success": "ADD_TASKS",
      "on_failure": "",
      "side_effects": [],
      "retry": {
        "max_attempts": 3,
        "backoff": "exponential",
        "initial_delay_ms": 3000
      },
      "timeout_ms": 300000,
      "prompt_id": "sprint_planning/goal",
      "context": {
        "sources": [
          {
            "provider": "project",
            "config": {}
          },
          {
            "provider": "state",
            "config": {
              "query": {}
            }
          },
          {
            "provider": "ckg",
            "config": {
              "query": {
                "type": "decision"
              },
              "max_nodes": 15
            }
          },
          {
            "provider": "delta",
            "config": {
              "max_results": 10
            }
          }
        ],
        "focus": {
          "role": "defining sprint goal",
          "constraints": [
            "Use all available layers to define a meaningful, achievable sprint goal"
          ],
          "context_priority": "project \u2192 delta \u2192 state \u2192 ckg"
        },
        "budget": {
          "max_tokens": 80000,
          "reserve_for_response": 10000,
          "strategy": "truncate"
        }
      }
    },
    {
      "key": "ADD_TASKS",
      "label": "Add tasks",
      "execution": "llm_task",
      "action": "add_tasks",
      "input_schema": {
        "type": "object",
        "properties": {
          "task": {
            "type": "object",
            "description": "Tarea a agregar al plan del sprint",
            "properties": {
              "objective": {
                "type": "string",
                "description": "Descripci\u00f3n de la tarea",
                "examples": [
                  "Implementar autenticaci\u00f3n OAuth2"
                ]
              },
              "type": {
                "type": "string",
                "enum": [
                  "feature",
                  "refactor",
                  "bugfix",
                  "docs",
                  "chore"
                ],
                "description": "Tipo de tarea"
              },
              "domain": {
                "type": "string",
                "description": "Dominio del proyecto",
                "examples": [
                  "engine"
                ]
              },
              "result_state": {
                "type": "string",
                "description": "Estado esperado al completar (opcional)",
                "examples": [
                  "Endpoint funcional con tests"
                ]
              }
            },
            "required": [
              "objective",
              "type",
              "domain"
            ],
            "examples": [
              {
                "objective": "Implementar autenticaci\u00f3n",
                "type": "feature",
                "domain": "engine"
              }
            ]
          },
          "done": {
            "type": "boolean",
            "description": "true si no hay m\u00e1s tareas que agregar. Env\u00eda done: true para finalizar.",
            "examples": [
              false,
              true
            ]
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "added",
              "completed"
            ],
            "description": "added si se agreg\u00f3 la tarea, completed si se finaliz\u00f3 con done:true"
          },
          "task_id": {
            "type": "string",
            "description": "ID de la tarea agregada (si status=added)"
          },
          "task_count": {
            "type": "integer",
            "description": "Total de tareas en el plan"
          }
        },
        "description": "Tarea agregada o plan completado. Si status=completed \u2192 transici\u00f3n a VALIDATE."
      },
      "on_success": "VALIDATE",
      "on_failure": "",
      "side_effects": [],
      "timeout_ms": 600000,
      "prompt_id": "sprint_planning/add-tasks",
      "context": {
        "sources": [
          {
            "provider": "project",
            "config": {}
          },
          {
            "provider": "state",
            "config": {
              "query": {}
            }
          },
          {
            "provider": "delta",
            "config": {
              "max_results": 10
            }
          },
          {
            "provider": "ckg",
            "config": {
              "query": {
                "type": "convention"
              },
              "max_nodes": 10
            }
          },
          {
            "provider": "cpg",
            "config": {
              "max_results": 15
            }
          },
          {
            "provider": "trace",
            "config": {
              "max_events": 5
            }
          }
        ],
        "focus": {
          "role": "adding tasks to sprint plan",
          "constraints": [
            "Check CKG for project conventions and patterns to inform task breakdown",
            "Check CPG for code structure that needs to be modified",
            "Check TRACE for recent history of what's been worked on",
            "Cross-reference all available layers to identify what tasks are still needed"
          ],
          "context_priority": "project \u2192 state \u2192 delta \u2192 ckg \u2192 cpg \u2192 trace"
        },
        "budget": {
          "max_tokens": 80000,
          "reserve_for_response": 10000,
          "strategy": "truncate"
        }
      }
    },
    {
      "key": "VALIDATE",
      "label": "Validate plan",
      "execution": "auto",
      "action": "validate_plan",
      "input_schema": {},
      "output_schema": {
        "type": "object",
        "properties": {
          "valid": {
            "type": "boolean"
          },
          "errors": {
            "type": "array"
          }
        }
      },
      "on_success": "REVIEW",
      "on_failure": "ADD_TASKS",
      "side_effects": [],
      "retry": {
        "max_attempts": 2,
        "backoff": "fixed",
        "initial_delay_ms": 1000
      },
      "timeout_ms": 30000,
      "context": {
        "budget": {
          "max_tokens": 80000,
          "reserve_for_response": 10000,
          "strategy": "truncate"
        }
      }
    },
    {
      "key": "REVIEW",
      "label": "Review plan",
      "execution": "llm_task",
      "input_schema": {
        "type": "object",
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "revise"
            ],
            "description": "Decisi\u00f3n sobre el plan: approve si est\u00e1 correcto, revise si necesita cambios",
            "examples": [
              "approve",
              "revise"
            ]
          },
          "notes": {
            "type": "string",
            "description": "Notas sobre la revisi\u00f3n (obligatorio si decision=revise)",
            "examples": [
              "Falta desglosar la tarea de testing en subtareas",
              "El plan est\u00e1 completo y bien estructurado"
            ]
          }
        },
        "required": [
          "decision"
        ]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "approved",
              "revised"
            ],
            "description": "Resultado de la revisi\u00f3n"
          },
          "notes": {
            "type": "string",
            "description": "Notas registradas"
          }
        },
        "description": "Plan revisado. Si approved \u2192 transici\u00f3n a SPRINT.ACTIVE. Si revised \u2192 vuelve a ADD_TASKS."
      },
      "on_success": "",
      "on_failure": "ADD_TASKS",
      "side_effects": [
        {
          "type": "emit_event",
          "params": {
            "event": "plan_reviewed"
          }
        }
      ],
      "retry": {
        "max_attempts": 3,
        "backoff": "exponential",
        "initial_delay_ms": 3000
      },
      "timeout_ms": 120000,
      "prompt_id": "sprint_planning/review",
      "context": {
        "sources": [
          {
            "provider": "project",
            "config": {}
          },
          {
            "provider": "state",
            "config": {
              "query": {}
            }
          },
          {
            "provider": "ckg",
            "config": {
              "query": {
                "type": "convention"
              },
              "max_nodes": 10
            }
          }
        ],
        "focus": {
          "role": "reviewing sprint plan",
          "constraints": [
            "Verify tasks align with the goal and follow project standards"
          ],
          "context_priority": "project \u2192 state \u2192 ckg"
        },
        "budget": {
          "max_tokens": 80000,
          "reserve_for_response": 10000,
          "strategy": "truncate"
        }
      }
    }
  ]
}