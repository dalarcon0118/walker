[
 {
  "from": "START",
  "to": "SPRINT",
  "gate": "project_selected",
  "sub_state_gate": "ACTIVE",
  "description": "Existing project selected. Transform resolves ACTIVE or PLANNING based on active sprint.",
  "intent": "advance",
  "available_from": [
   "SELECT"
  ]
 },
 {
  "from": "START",
  "to": "PROJECT_INIT",
  "gate": "create_project",
  "sub_state_gate": "DETECT",
  "description": "Create new project. Delegates to PROJECT_INIT (sibling node).",
  "intent": "advance",
  "available_from": [
   "SELECT"
  ]
 },
 {
  "from": "START",
  "to": "START",
  "gate": "refresh",
  "sub_state_gate": "LIST",
  "description": "Refresh project list.",
  "intent": "abandon",
  "available_from": [
   "SELECT"
  ]
 },
 {
  "from": "SPRINT",
  "to": "START",
  "gate": "back_to_start",
  "sub_state_gate": "LIST",
  "description": "Return to start to switch projects.",
  "intent": "abandon",
  "available_from": [
   "PLANNING",
   "PLAN_APPROVAL",
   "TASK_REVIEW",
   "ACTIVE",
   "REVIEW",
   "RETRO",
   "CLOSE_CONFIRM",
   "CLOSE",
   "SPEC_REVIEW"
  ]
 },
 {
  "from": "PROJECT_INIT",
  "to": "START",
  "gate": "back_to_start",
  "sub_state_gate": "LIST",
  "description": "Return to start from PROJECT_INIT (cancel creation).",
  "intent": "abandon",
  "available_from": [
   "REVIEW",
   "FIRST_SPRINT"
  ]
 },
 {
  "from": "SPRINT",
  "to": "SPRINT",
  "gate": "plan_approval_approved",
  "source_sub_state": "PLAN_APPROVAL",
  "sub_state_gate": "TASK_SPEC",
  "description": "Sprint plan approved by PO. Proceed to task specification.",
  "contract": {
   "pre": "ckg_has_decision('approve')",
   "post": "SPRINT.TASK_SPEC.status == 'pending'"
  },
  "intent": "advance"
 },
 {
  "from": "SPRINT",
  "to": "SPRINT",
  "gate": "plan_approval_revised",
  "source_sub_state": "PLAN_APPROVAL",
  "sub_state_gate": "PLANNING",
  "description": "Sprint plan needs revision. Return to planning.",
  "contract": {
   "pre": "ckg_has_decision('revise')"
  },
  "intent": "abandon"
 },
 {
  "from": "SPRINT",
  "to": "SPRINT",
  "gate": "refine_task",
  "source_sub_state": "TASK_REVIEW",
  "sub_state_gate": "TASK_SPEC",
  "description": "Re-specify current task (from TASK_REVIEW).",
  "intent": "abandon"
 },
 {
  "from": "SPRINT",
  "to": "SPRINT",
  "gate": "next_task",
  "source_sub_state": "TASK_REVIEW",
  "sub_state_gate": "TASK_SPEC",
  "description": "Next task specification (from TASK_REVIEW).",
  "intent": "advance"
 },
 {
  "from": "SPRINT",
  "to": "SPRINT",
  "gate": "all_done",
  "source_sub_state": "TASK_REVIEW",
  "sub_state_gate": "SPEC_REVIEW",
  "description": "All tasks specified; mandatory spec review before implementation.",
  "intent": "advance"
 },
 {
  "from": "SPRINT",
  "to": "SPRINT",
  "gate": "spec_review_accepted",
  "source_sub_state": "SPEC_REVIEW",
  "sub_state_gate": "ACTIVE",
  "description": "Spec review accepted by PO. Proceed to implementation.",
  "contract": {
   "pre": "ckg_has_decision('accept')"
  },
  "intent": "advance"
 },
 {
  "from": "SPRINT",
  "to": "SPRINT",
  "gate": "spec_review_needs_work",
  "source_sub_state": "SPEC_REVIEW",
  "sub_state_gate": "TASK_SPEC",
  "description": "Spec review needs work. Return to task spec.",
  "contract": {
   "pre": "ckg_has_decision('needs_work')"
  },
  "intent": "abandon"
 },
 {
  "from": "SPRINT",
  "to": "DESIGN",
  "gate": "start_task",
  "source_sub_state": "ACTIVE",
  "sub_state_gate": "DESIGN_GATHER",
  "description": "Start task: design phase first (from ACTIVE).",
  "intent": "advance"
 },
 {
  "from": "SPRINT",
  "to": "SPRINT",
  "gate": "edit_plan",
  "source_sub_state": "ACTIVE",
  "sub_state_gate": "PLANNING",
  "description": "Return to sprint planning to adjust backlog (from ACTIVE).",
  "intent": "abandon"
 },
 {
  "from": "SPRINT",
  "to": "SPRINT",
  "gate": "goal_invalidation",
  "source_sub_state": "ACTIVE",
  "sub_state_gate": "PLANNING",
  "description": "PHASE 12 MONITORING (Gollwitzer): invalidation condition detected on the committed sprint goal - re-deliberate the plan (back to PLANNING). Register WHAT invalidated the goal in the transition reason.",
  "intent": "abandon"
 },
 {
  "from": "SPRINT",
  "to": "SPRINT",
  "gate": "start_review",
  "source_sub_state": "ACTIVE",
  "sub_state_gate": "REVIEW",
  "description": "Start sprint review (from ACTIVE).",
  "intent": "advance"
 },
 {
  "from": "SPRINT",
  "to": "SPRINT",
  "gate": "back_to_active",
  "sub_state_gate": "ACTIVE",
  "description": "Return to sprint dashboard.",
  "intent": "abandon",
  "available_from": [
   "ACTIVE",
   "REVIEW",
   "RETRO",
   "CLOSE_CONFIRM",
   "CLOSE"
  ]
 },
 {
  "from": "DESIGN",
  "to": "ANALYZE",
  "gate": "design_approved",
  "source_sub_state": "CKG_SAVE",
  "sub_state_gate": "GATHER",
  "description": "Design approved, proceed to task analysis.",
  "contract": {
   "pre": "ckg_has_decision('approve')",
   "post": "ANALYZE.GATHER.status == 'pending'"
  },
  "intent": "advance"
 },
 {
  "from": "DESIGN",
  "to": "REFINE",
  "gate": "design_needs_refine",
  "sub_state_gate": "DIAGNOSE",
  "description": "Design needs refinement.",
  "contract": {
   "pre": "ckg_has_decision('refine')"
  },
  "intent": "abandon",
  "available_from": [
   "DESIGN_REVIEW",
   "CKG_SAVE"
  ]
 },
 {
  "from": "ANALYZE",
  "to": "IMPLEMENT",
  "gate": "analysis_approved",
  "sub_state_gate": "USER_GATE",
  "description": "Analysis approved, proceed to implementation.",
  "contract": {
   "pre": "ckg_has_decision('approve')",
   "post": "IMPLEMENT.USER_GATE.status == 'pending'",
   "invariants": [
    "No pending tasks in ANALYZE phase"
   ]
  },
  "intent": "advance",
  "available_from": [
   "REVIEW",
   "KNOWLEDGE_CAPTURE"
  ]
 },
 {
  "from": "ANALYZE",
  "to": "REFINE",
  "gate": "needs_refine",
  "sub_state_gate": "DIAGNOSE",
  "description": "Analysis needs refinement.",
  "intent": "abandon",
  "available_from": [
   "REVIEW"
  ]
 },
 {
  "from": "IMPLEMENT",
  "to": "VERIFY",
  "gate": "implementation_done",
  "sub_state_gate": "QA_RUN",
  "description": "Implementation completed, proceed to verification.",
  "contract": {
   "pre": "ckg_has_decision('proceed')",
   "post": "VERIFY.QA_RUN.status == 'pending'",
   "invariants": [
    "CODE_REVIEW_SCAN.passed == true"
   ]
  },
  "intent": "advance",
  "available_from": [
   "USER_GATE",
   "REPORT_GATE"
  ]
 },
 {
  "from": "IMPLEMENT",
  "to": "REFINE",
  "gate": "needs_refine",
  "sub_state_gate": "DIAGNOSE",
  "description": "Implementation needs refinement.",
  "intent": "abandon",
  "available_from": [
   "USER_GATE",
   "CODE_REVIEW_RESULT",
   "REPORT_GATE"
  ]
 },
 {
  "from": "IMPLEMENT",
  "to": "SPRINT",
  "gate": "cancel",
  "sub_state_gate": "ACTIVE",
  "description": "Task cancelled. Return to sprint dashboard.",
  "intent": "abandon",
  "available_from": [
   "USER_GATE",
   "CODE_REVIEW_RESULT",
   "REPORT_GATE"
  ]
 },
 {
  "from": "VERIFY",
  "to": "SPRINT",
  "gate": "task_complete",
  "sub_state_gate": "ACTIVE",
  "description": "Task completed, return to sprint dashboard.",
  "contract": {
   "pre": "ckg_has_decision('accept')",
   "post": "SPRINT.ACTIVE.status == 'ready'",
   "invariants": [
    "Task marked complete in sprint-state",
    "CKG.status == up_to_date"
   ]
  },
  "intent": "advance",
  "available_from": [
   "PO_ACCEPT"
  ]
 },
 {
  "from": "VERIFY",
  "to": "REFINE",
  "gate": "needs_refine",
  "sub_state_gate": "DIAGNOSE",
  "description": "Verification needs refinement.",
  "intent": "abandon",
  "available_from": [
   "QA",
   "PO_ACCEPT"
  ]
 },
 {
  "from": "REFINE",
  "to": "DESIGN",
  "gate": "reroute_design",
  "sub_state_gate": "DESIGN_GATHER",
  "description": "Refine from design phase.",
  "intent": "abandon",
  "available_from": [
   "CONFIRM_GATE",
   "ESCALATION"
  ]
 },
 {
  "from": "REFINE",
  "to": "ANALYZE",
  "gate": "reroute_analyze",
  "sub_state_gate": "GATHER",
  "description": "Refine from analysis phase.",
  "intent": "abandon",
  "available_from": [
   "CONFIRM_GATE",
   "ESCALATION"
  ]
 },
 {
  "from": "REFINE",
  "to": "IMPLEMENT",
  "gate": "reroute_implement",
  "sub_state_gate": "WORK",
  "description": "Refine from implementation phase.",
  "intent": "abandon",
  "available_from": [
   "CONFIRM_GATE",
   "ESCALATION"
  ]
 },
 {
  "from": "REFINE",
  "to": "VERIFY",
  "gate": "reroute_verify",
  "sub_state_gate": "QA_RUN",
  "description": "Refine from verification phase.",
  "intent": "abandon",
  "available_from": [
   "CONFIRM_GATE",
   "ESCALATION"
  ]
 },
 {
  "from": "REFINE",
  "to": "SPRINT",
  "gate": "reroute_sprint",
  "sub_state_gate": "ACTIVE",
  "description": "Return to sprint (task not refinable).",
  "intent": "abandon",
  "available_from": [
   "CONFIRM_GATE",
   "ESCALATION"
  ]
 },
 {
  "from": "REFINE",
  "to": "SPRINT",
  "gate": "escalation",
  "sub_state_gate": "ACTIVE",
  "description": "Refinement limit reached (3 attempts). Escalate to sprint for manual review.",
  "intent": "abandon",
  "available_from": [
   "CONFIRM_GATE",
   "ESCALATION"
  ]
 },
 {
  "from": "SPRINT",
  "to": "PROJECT_INIT",
  "gate": "init_project",
  "source_sub_state": "ACTIVE",
  "sub_state_gate": "DETECT",
  "description": "Initialize a new project from scratch (from ACTIVE).",
  "intent": "advance"
 },
 {
  "from": "PROJECT_INIT",
  "to": "SPRINT",
  "gate": "project_ready",
  "sub_state_gate": "ACTIVE",
  "description": "Project initialized, return to sprint dashboard.",
  "intent": "advance",
  "available_from": [
   "REVIEW",
   "FIRST_SPRINT"
  ]
 },
 {
  "from": "PROJECT_INIT",
  "to": "PROJECT_INIT",
  "gate": "revise_specs",
  "sub_state_gate": "GATHER_SPECS",
  "description": "Revise project specifications.",
  "intent": "abandon",
  "available_from": [
   "REVIEW"
  ]
 },
 {
  "from": "SPRINT",
  "to": "SPRINT",
  "gate": "review_accepted",
  "source_sub_state": "REVIEW",
  "sub_state_gate": "REPORT",
  "description": "Sprint review accepted: present the PO report before the retrospective.",
  "intent": "advance"
 },
 {
  "from": "SPRINT",
  "to": "SPRINT",
  "gate": "report_delivered",
  "source_sub_state": "REPORT",
  "sub_state_gate": "RETRO",
  "description": "PO report delivered (summary + metrics + risks + next): continue to retrospective.",
  "intent": "advance"
 },
 {
  "from": "SPRINT",
  "to": "SPRINT",
  "gate": "review_needs_work",
  "source_sub_state": "REVIEW",
  "sub_state_gate": "ACTIVE",
  "description": "Sprint review needs work: return to dashboard.",
  "intent": "abandon"
 },
 {
  "from": "SPRINT",
  "to": "SPRINT",
  "gate": "close_confirmed",
  "source_sub_state": "CLOSE_CONFIRM",
  "sub_state_gate": "CLOSE",
