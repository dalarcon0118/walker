{
  "label": "Task Analysis",
  "description": "Task investigation, analysis, and approval before implementation.",
  "provides": [
    "analysis_summary"
  ],
  "sub_states": [
    {
      "key": "GATHER",
      "label": "Update code index before analysis",
      "execution": "auto",
      "action": "sync_code_index",
      "input_schema": {},
      "output_schema": {},
      "on_success": "BASELINE",
      "on_failure": "",
      "side_effects": [
        {
          "type": "index_code",
          "params": {},
          "optional": true
        }
      ],
      "retry": {
        "max_attempts": 2,
        "backoff": "exponential",
        "initial_delay_ms": 2000
      },
      "timeout_ms": 120000,
      "prompt_id": "analyze/gather",
      "audit": {
        "capture_stdout": true,
        "capture_stderr": true,
        "level": "normal"
      },
      "context": {
        "budget": {
          "max_tokens": 80000,
          "reserve_for_response": 10000,
          "strategy": "truncate"
        }
      }
    },
    {
      "key": "BASELINE",
      "label": "Baseline del scope (punto A)",
      "execution": "auto",
      "action": "capture_baseline",
      "input_schema": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "string"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "baseline": {
            "type": "string"
          }
        },
        "description": "Punto A persistido"
      },
      "on_success": "OBSERVE",
      "on_failure": "",
      "timeout_ms": 180000,
      "audit": {
        "capture_stdout": true,
        "capture_stderr": true,
        "level": "normal"
      }
    },
    {
      "key": "OBSERVE",
      "label": "PHASE 0 Observe: capture evidence without interpreting",
      "execution": "llm_task",
      "action": "observe",
      "needs": [
        "project_id",
        "task_id",
        "sprint_id"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "facts": {
            "type": "array",
            "description": "New information taken directly from the environment (code, tests, context layers)",
            "items": {
              "type": "string"
            }
          },
          "inferred_information": {
            "type": "array",
            "description": "Conclusions derived from facts, explicitly marked as inference (not fact)",
            "items": {
              "type": "string"
            }
          },
          "assumptions": {
            "type": "array",
            "description": "Suppositions without evidence yet",
            "items": {
              "type": "string"
            }
          },
          "contradictions": {
            "type": "array",
            "description": "Information that contradicts the previous state",
            "items": {
              "type": "string"
            }
          },
          "paths": {
            "type": "array",
            "description": "Files/locations observed",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "string",
            "description": "Raw evidence captured (outputs, snippets, logs)"
          }
        },
        "required": [
          "facts"
        ]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "phase": {
            "type": "string",
            "enum": [
              "observe"
            ],
            "description": "Gollwitzer phase recorded by the action"
          },
          "observed": {
            "type": "boolean",
            "description": "true cuando el paso registró observe"
          }
        },
        "description": "Observation recorded (facts/inferences/assumptions/contradictions). Transitions to INFO_GATE.",
        "required": []
      },
      "on_success": "INFO_GATE",
      "on_failure": "GATHER",
      "side_effects": [],
      "retry": {
        "max_attempts": 2,
        "backoff": "exponential",
        "initial_delay_ms": 3000
      },
      "timeout_ms": 300000,
      "prompt_id": "analyze/observe",
      "context": {
        "sources": [
          {
            "provider": "project",
            "config": {}
          },
          {
            "provider": "task",
            "config": {}
          },
          {
            "provider": "state",
            "config": {
              "query": {}
            }
          },
          {
            "provider": "cpg",
            "config": {
              "max_results": 10
            }
          },
          {
            "provider": "trace",
            "config": {
              "max_events": 5
            }
          }
        ],
        "focus": {
          "role": "observing the environment for task {task_id} in sprint \"{sprint_goal}\" — capture, do not interpret",
          "constraints": [
            "Separate facts from inferences and assumptions (PHASE 0 discipline)",
            "Mark contradictions against the previous state explicitly",
            "Do not decide, do not plan — observation only"
          ],
          "context_priority": "task → cpg → state → trace"
        },
        "budget": {
          "max_tokens": 80000,
          "reserve_for_response": 10000,
          "strategy": "truncate"
        }
      },
      "audit": {
        "level": "normal"
      }
    },
    {
      "key": "INFO_GATE",
      "label": "PHASE 11 Information acquisition gate (decision value)",
      "execution": "llm_task",
      "action": "info_acquisition",
      "needs": [
        "project_id",
        "task_id",
        "sprint_id"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "sufficient",
              "acquired",
              "blocked"
            ],
            "description": "sufficient: state is enough for deliberation. acquired: missing info was obtainable and has been acquired now. blocked: unobtainable, uncertainties registered."
          },
          "missing_information": {
            "type": "array",
            "description": "Information that was missing for goal evaluation",
            "items": {
              "type": "string"
            }
          },
          "queries": {
            "type": "array",
            "description": "Targeted queries executed to acquire the missing information",
            "items": {
              "type": "string"
            }
          },
          "resolved_gaps": {
            "type": "array",
            "description": "Gaps closed by the acquisition round",
            "items": {
              "type": "string"
            }
          },
          "uncertainties": {
            "type": "array",
            "description": "Unresolvable uncertainties registered (blocked path) — deliberation will account for them",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "decision"
        ]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "phase": {
            "type": "string",
            "enum": [
              "info_acquisition"
            ],
            "description": "Gollwitzer phase recorded by the action"
          },
          "acquired": {
            "type": "boolean",
            "description": "true cuando el paso registró info_gate"
          }
        },
        "description": "Decision-value gate passed. Transitions to ANALYZE (deliberation).",
        "required": []
      },
      "on_success": "ANALYZE",
      "on_failure": "GATHER",
      "side_effects": [],
      "retry": {
        "max_attempts": 2,
        "backoff": "exponential",
        "initial_delay_ms": 3000
      },
      "timeout_ms": 300000,
      "prompt_id": "analyze/info-gate",
      "context": {
        "sources": [
          {
            "provider": "project",
            "config": {}
          },
          {
            "provider": "task",
            "config": {}
          },
          {
            "provider": "state",
            "config": {
              "query": {}
            }
          },
          {
            "provider": "ckg",
            "config": {
              "query": {
                "type": "decision"
              },
              "max_nodes": 10
            }
          },
          {
            "provider": "cpg",
            "config": {
              "max_results": 10
            }
          }
        ],
        "focus": {
          "role": "gating information acquisition for task {task_id} — only info that can change a decision",
          "constraints": [
            "Do NOT collect information by default (PHASE 11 discipline)",
            "If missing info is obtainable, acquire it via context tasks BEFORE submitting",
            "If unobtainable, register uncertainties instead of guessing (DO NOT GUESS)"
          ],
          "context_priority": "task → state → ckg → cpg"
        },
        "budget": {
          "max_tokens": 80000,
          "reserve_for_response": 10000,
          "strategy": "truncate"
        }
      },
      "audit": {
        "level": "normal"
      }
    },
    {
      "key": "ANALYZE",
      "label": "6->3 analysis",
      "execution": "llm_task",
      "needs": [
        "project_id",
        "task_id",
        "sprint_id"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "q1": {
            "type": "string",
            "description": "Question 1 of the 6->3 analysis",
            "examples": [
              "What components currently exist in the code?"
            ]
          },
          "a1": {
            "type": "string",
            "minLength": 10,
            "description": "Answer to question 1",
            "examples": [
              "There are currently 3 main components: A, B, and C"
            ]
          },
          "q2": {
            "type": "string",
            "description": "Question 2 of the 6->3 analysis",
            "examples": [
              "What impact does the task have on each component?"
            ]
          },
          "a2": {
            "type": "string",
            "minLength": 10,
            "description": "Answer to question 2",
            "examples": [
              "The task affects component A because it introduces a new flow"
            ]
          },
          "q3": {
            "type": "string",
            "description": "Question 3 of the 6->3 analysis",
            "examples": [
              "What implementation approach is recommended?"
            ]
          },
          "a3": {
            "type": "string",
            "minLength": 10,
            "description": "Answer to question 3",
            "examples": [
              "Recommended approach: Strategy pattern in the domain layer"
            ]
          },
          "preconditions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "description": "Premisas verificables de las que depende la implementacion"
          }
        },
        "required": [
          "q1",
          "a1",
          "q2",
          "a2",
          "q3",
          "a3",
          "preconditions"
        ]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "analyzed"
            ],
            "description": "Analysis completed"
          },
          "summary": {
            "type": "string",
            "description": "Analysis summary"
          }
        },
        "description": "6->3 analysis completed. Transitions to REVIEW for approval."
      },
      "on_success": "REVIEW",
      "on_failure": "GATHER",
      "side_effects": [],
      "retry": {
        "max_attempts": 3,
        "backoff": "exponential",
        "initial_delay_ms": 5000
      },
      "timeout_ms": 300000,
      "prompt_id": "analyze/analyze",
      "required_fields": [
        "preconditions"
      ],
      "context": {
        "sources": [
          {
            "provider": "project",
            "config": {}
          },
          {
            "provider": "task",
            "config": {}
          },
          {
            "provider": "state",
            "config": {
              "query": {}
            }
          },
          {
            "provider": "ckg",
            "config": {
              "query": {
                "type": "decision"
              },
              "max_nodes": 15
            }
          },
          {
            "provider": "cpg",
            "config": {
              "query": {
                "file": "features"
              },
              "max_results": 20
            }
          },
          {
            "provider": "trace",
            "config": {
              "max_events": 5
            }
          }
        ],
        "focus": {
          "role": "analyzing task {task_id} for sprint \"{sprint_goal}\"",
          "constraints": [
            "Base your architecture analysis on CKG patterns + CPG code structure",
            "Consider each architectural layer (domain, application, infrastructure) when assessing impact"
          ],
          "context_priority": "project → task → ckg → cpg → state → trace"
        },
        "budget": {
          "max_tokens": 80000,
          "reserve_for_response": 10000,
          "strategy": "truncate"
        }
      },
      "audit": {
        "level": "normal"
      }
    },
    {
      "key": "REVIEW",
      "label": "Review analysis",
      "execution": "user_input",
      "input_schema": {},
      "output_schema": {
        "type": "object",
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "reject"
            ],
            "description": "PO decision on analysis and knowledge"
          },
          "evidence": {
            "type": "string",
            "description": "PO feedback"
          },
          "knowledge_items": {
            "type": "array",
            "description": "Knowledge captured during review (lessons/patterns)",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "decision"
        ],
        "description": "Analysis + knowledge reviewed. approve -> KNOWLEDGE_CAPTURE (auto) -> IMPLEMENT."
      },
      "on_success": "KNOWLEDGE_CAPTURE",
      "on_failure": "GATHER",
      "side_effects": [
        {
          "type": "capture_decision",
          "params": {}
        }
      ],
      "timeout_ms": 600000,
      "prompt_id": "analyze/review",
      "context": {
        "sources": [
          {
            "provider": "project",
            "config": {}
          },
          {
            "provider": "task",
            "config": {}
          },
          {
            "provider": "state",
            "config": {
              "query": {}
            }
          }
        ],
        "focus": {
          "role": "reviewing analysis results for task {task_id}",
          "constraints": [
            "Present the 6->3 analysis summary from the STATE layer",
            "Show task objective, impacted files, and risks from TASK layer",
            "Show project conventions from PROJECT layer for context",
            "Ask user to approve or reject the analysis"
          ],
          "context_priority": "project → task → state"
        },
        "budget": {
          "max_tokens": 80000,
          "reserve_for_response": 10000,
          "strategy": "truncate"
        }
      },
      "audit": {
        "capture_decision": true,
        "capture_evidence": true,
        "level": "full"
      },
      "decision_map": {
        "approve": "analysis_approved",
        "reject": "needs_refine"
      }
    },
    {
      "key": "KNOWLEDGE_CAPTURE",
      "label": "Capture knowledge",
      "execution": "auto",
      "input_schema": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string"
          },
          "task_id": {
            "type": "string"
          },
          "artefactos": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Artefactos generados: [{nombre, tipo (diagrama|doc|codigo), descripcion}]"
          },
          "reglas": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Reglas/convenciones: [{regla, scope, severidad (obligatoria|recomendada|informativa)}]"
          },
          "decisiones": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Decisiones de diseño: [{decision, alternativas[], razon}]"
          },
          "advertencias": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Riesgos: [{advertencia, impacto, mitigacion}]"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "fact": {
            "type": "string"
          }
        },
        "description": "Hecho de la sesión escrito en el CKG"
      },
      "on_success": "",
      "on_failure": "REVIEW",
      "side_effects": [
        {
          "type": "documenting_knowledge",
          "params": {},
          "compensation": {
            "type": "remove_knowledge",
            "description": "If transition to next phase fails, rollback captured knowledge"
          }
        },
        {
          "type": "emit_event",
          "params": {
            "event": "knowledge_captured"
          }
        },
        {
          "type": "update_knowledge_status",
          "params": {
            "event": "knowledge_captured"
          },
          "description": "Mark CKG as up_to_date after knowledge capture"
        }
      ],
      "retry": {
        "max_attempts": 2,
        "backoff": "exponential",
        "initial_delay_ms": 3000
      },
      "timeout_ms": 60000,
      "prompt_id": "analyze/knowledge-capture",
      "context": {
        "sources": [
          {
            "provider": "project",
            "config": {}
          },
          {
            "provider": "task",
            "config": {}
          },
          {
            "provider": "state",
            "config": {
              "query": {}
            }
          },
          {
            "provider": "ckg",
            "config": {
              "query": {
                "type": "decision"
              },
              "max_nodes": 10
            }
          },
          {
            "provider": "cpg",
            "config": {
              "max_results": 10
            }
          },
          {
            "provider": "trace",
            "config": {
              "max_events": 5
            }
          }
        ],
        "focus": {
          "role": "extracting knowledge from the analysis of task {task_id} for sprint \"{sprint_goal}\"",
          "constraints": [
            "Check CKG first to see what knowledge already exists — avoid duplicating existing decisions or patterns",
            "Use CPG to reference specific code structures impacted",
            "Extract artifacts, rules, design decisions, and warnings from the analysis"
          ],
          "context_priority": "project → task → ckg → cpg → state → trace"
        },
        "budget": {
          "max_tokens": 80000,
          "reserve_for_response": 10000,
          "strategy": "truncate"
        }
      },
      "audit": {
        "level": "normal"
      },
      "action": "capture_knowledge"
    }
  ]
}
