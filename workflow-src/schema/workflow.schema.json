{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schema/workflow.schema.json",
  "title": "Workflow v3 Enterprise Schema",
  "description": "Schema for modular workflow.v3/ — supports import-based composition (entry workflow.json + per-node files + edges.json) and legacy single-file format.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "initial_state"
  ],
  "oneOf": [
    {
      "required": [
        "nodes",
        "edges"
      ]
    },
    {
      "required": [
        "import"
      ]
    }
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference for the workflow file."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Schema version."
    },
    "description": {
      "type": "string",
      "minLength": 5,
      "maxLength": 1000
    },
    "context_bag": {
      "type": "object",
      "description": "Catalogo de placeholders que el engine resuelve en on_entry_message antes de presentarlo al agente.",
      "properties": {
        "description": {
          "type": "string"
        },
        "placeholders": {
          "type": "object",
          "patternProperties": {
            "^[a-z_]+$": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "available_in": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "source",
                "description"
              ]
            }
          }
        }
      },
      "required": [
        "placeholders"
      ]
    },
    "context_schema": {
      "type": "object",
      "description": "SSOT del contexto de entrada (F2 SPEC-043 / ADR-043 §9.2-A): mapa provider → JSON Schema de la capa que el agente recibe. Se deriva de engine/context/contracts CONTEXT_SCHEMAS (9 providers).",
      "properties": {
        "description": {
          "type": "string"
        },
        "providers": {
          "type": "object",
          "description": "Clave = nombre del provider (business, ckg, cpg, delta, diff, project, reflection, test_results, trace). Valor = JSON Schema de la capa.",
          "additionalProperties": {
            "type": "object"
          }
        }
      }
    },
    "initial_state": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Z][A-Z_]*$"
    },
    "import": {
      "type": "object",
      "description": "Importa nodos y edges desde archivos externos. Resuelto por el loader en build_graph().",
      "additionalProperties": false,
      "required": [
        "nodes"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^nodes/[a-z_]+\\.node\\.json$",
            "description": "Ruta relativa al archivo de nodo."
          },
          "description": "Lista de archivos de nodo a importar."
        },
        "edges": {
          "type": "string",
          "pattern": "^.+\\.json$",
          "description": "Ruta al archivo de edges."
        }
      }
    },
    "nodes": {
      "type": "object",
      "minProperties": 2,
      "propertyNames": {
        "pattern": "^[A-Z][A-Z_]*$"
      },
      "patternProperties": {
        "^[A-Z][A-Z_]*$": {
          "$ref": "#/definitions/node_file"
        }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "gate",
          "description"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "gate": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          },
          "description": {
            "type": "string",
            "minLength": 5,
            "maxLength": 500
          },
          "sub_state_gate": {
            "type": "string"
          },
          "contract": {
            "type": "object",
            "properties": {
              "pre": {
                "type": "string"
              },
              "post": {
                "type": "string"
              },
              "note": {
                "type": "string"
              },
              "invariants": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Invariant conditions that must hold true at the edge."
              }
            }
          },
          "transform": {
            "type": "object",
            "description": "Data transformation between source and target nodes.",
            "properties": {
              "action": {
                "type": "string",
                "description": "TaskRegistry action that performs the transformation."
              },
              "input": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Source data selectors (e.g. ['ANALYZE.*', 'WORK.result'])."
              },
              "output": {
                "type": "string",
                "description": "Target context key to store transformed data."
              }
            },
            "required": [
              "action",
              "input",
              "output"
            ]
          }
        }
      }
    },
    "on": {
      "type": "object",
      "description": "Declarative event handlers. Triggers when events are emitted via side_effects.",
      "properties": {
        "sprint_planned": {
          "$ref": "#/definitions/event_handler"
        },
        "task_approved": {
          "$ref": "#/definitions/event_handler"
        },
        "qa_failed": {
          "$ref": "#/definitions/event_handler"
        },
        "implementation_rejected": {
          "$ref": "#/definitions/event_handler"
        },
        "refine_exhausted": {
          "$ref": "#/definitions/event_handler"
        },
        "sprint_closed": {
          "$ref": "#/definitions/event_handler"
        }
      }
    },
    "tracing": {
      "type": "object",
      "description": "Global tracing and observability configuration.",
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "minimal",
            "normal",
            "full"
          ],
          "default": "normal"
        },
        "track": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "NODE_ENTRY",
              "SUB_STATE",
              "SUBMIT",
              "AUTO_EXECUTE",
              "TRANSITION",
              "SESSION",
              "ERROR"
            ]
          },
          "description": "Which trace event types to capture."
        }
      },
      "required": [
        "level",
        "track"
      ]
    }
  },
  "definitions": {
    "node_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "description",
        "sub_states"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1000
        },
        "sub_states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/sub_state"
          }
        }
      }
    },
    "sub_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "execution",
        "input_schema",
        "output_schema",
        "on_success",
        "on_failure"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Z][A-Z_]*$"
        },
        "label": {
          "type": "string",
          "maxLength": 80
        },
        "execution": {
          "type": "string",
          "enum": [
            "bootstrap",
            "auto",
            "llm_task",
            "user_input",
            "manual"
          ],
          "description": "bootstrap=engine inits, auto=TaskRegistry action, llm_task=LLM prompt, user_input=user option, manual=external work"
        },
        "action": {
          "type": "string",
          "description": "TaskRegistry action name (for auto/bootstrap/llm_task). Empty for user_input."
        },
        "input_schema": {
          "type": "object",
          "description": "JSON Schema for submit input validation."
        },
        "output_schema": {
          "type": "object",
          "description": "JSON Schema for execution output."
        },
        "on_success": {
          "type": "string",
          "description": "Next sub-state on success. Empty = node complete."
        },
        "on_failure": {
          "type": "string",
          "description": "Next sub-state on failure. Empty = error propagated."
        },
        "side_effects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "description": "Name canónico del side effect — debe existir en el catálogo real del SideEffectEngine (SPEC-014 F4: sin alias legacy).",
                 "enum": [
                   "advance_sprint_task",
                   "archive_sprint",
                   "build_project_graph",
                   "capture_decision",
                   "create_adr",
                   "remove_knowledge",
                   "detect_decisions",
                   "documenting_knowledge",
                   "emit_event",
                   "index_code",
                   "index_sprint_tasks",
                   "rebuild_sprint_index",
                   "restore_code_snapshot",
                   "sync_delta",
                   "transform_spec",
                   "update_knowledge_status",
                   "sprint_status",
                   "validate_plan"
                 ]
              },
              "params": {
                "type": "object"
              },
              "optional": {
                "type": "boolean",
                "default": false
              },
              "compensation": {
                "type": "object",
                "description": "Compensation action for Saga rollback if this side-effect needs to be reverted.",
                "properties": {
                  "type": {
                    "type": "string",
                    "description": "Name canónico del handler de compensación — resuelto contra el MISMO catálogo del SideEffectEngine (fuente única: el grafo declara, el catálogo ejecuta, SPEC-014 Fase 0). Fase 4: sin alias legacy.",
                    "enum": [
                      "remove_knowledge",
                      "restore_code_snapshot"
                    ]
                  },
                  "params": {
                    "type": "object"
                  },
                  "description": {
                    "type": "string"
                  }
                }
              },
              "idempotency_key": {
                "type": "string",
                "description": "Key ensuring this side-effect runs exactly once."
              }
            }
          }
        },
        "retry": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "max_attempts": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 3
                },
                "backoff": {
                  "type": "string",
                  "enum": [
                    "fixed",
                    "linear",
                    "exponential",
                    "jitter"
                  ],
                  "default": "exponential"
                },
                "initial_delay_ms": {
                  "type": "integer",
                  "minimum": 100,
                  "default": 1000
                },
                "on_error": {
                  "type": "object",
                  "description": "Error-specific recovery strategies. Maps error types to recovery actions.",
                  "additionalProperties": {
                    "type": "string",
                    "enum": [
                      "retry",
                      "retry_2x",
                      "compensate",
                      "escalate",
                      "block+message",
                      "log+continue",
                      "on_failure"
                    ]
                  }
                }
              },
              "required": [
                "max_attempts"
              ]
            }
          ]
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1000,
          "default": 120000,
          "description": "Execution timeout in ms."
        },
        "prompt": {
          "type": "string",
          "description": "Prompt template for llm_task. Supports {placeholders}."
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "requires": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "description": "Options for user_input execution."
        },
        "prompt_id": {
          "type": "string",
          "pattern": "^[a-z]+/[a-z_-]+$",
          "description": "Reference to prompts/{prompt_id}.prompt.md. Loaded by engine on entry."
        },
        "on_entry_message": {
          "type": "string",
          "maxLength": 3000,
          "description": "Agent instruction on entry. Supports {placeholders} resolved by engine. DEPRECATED — use prompt_id instead."
        },
        "required_tools": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "command_hint": {
                "type": "string"
              }
            }
          }
        },
        "audit": {
          "type": "object",
          "description": "Per-sub-state observability configuration.",
          "properties": {
            "capture_stdout": {
              "type": "boolean",
              "default": false
            },
            "capture_stderr": {
              "type": "boolean",
              "default": false
            },
            "capture_decision": {
              "type": "boolean",
              "default": false
            },
            "capture_evidence": {
              "type": "boolean",
              "default": false
            },
            "level": {
              "type": "string",
              "enum": [
                "minimal",
                "normal",
                "full"
              ],
              "default": "normal"
            }
          }
        }
      }
    },
    "event_handler": {
      "type": "object",
      "description": "Handler for a workflow event. Can run a script or trigger a transition.",
      "oneOf": [
        {
          "required": [
            "run"
          ]
        },
        {
          "required": [
            "transition"
          ]
        }
      ],
      "properties": {
        "run": {
          "type": "string",
          "description": "Script or TaskRegistry action to execute."
        },
        "transition": {
          "type": "string",
          "description": "Gate to transition on event."
        },
        "description": {
          "type": "string"
        }
      }
    }
  }
}