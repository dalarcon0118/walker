{
  "label": "Project Initialization",
  "description": "Initialize a new project from existing code, greenfield, or specification file. Builds CPG, CKG, project.json, and first sprint.",
  "sub_states": [
    {
      "key": "DETECT",
      "label": "Detect project context",
      "execution": "auto",
      "action": "detect_project_context",
      "input_schema": {},
      "output_schema": {
        "type": "object",
        "properties": {
          "has_code": {
            "type": "boolean"
          },
          "has_git": {
            "type": "boolean"
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "framework": {
            "type": "string"
          }
        }
      },
      "on_success": "SCENARIO",
      "on_failure": "",
      "side_effects": [],
      "timeout_ms": 30000,
      "prompt_id": "project_init/detect",
      "context": {
        "budget": {
          "max_tokens": 80000,
          "reserve_for_response": 10000,
          "strategy": "truncate"
        }
      }
    },
    {
      "key": "SCENARIO",
      "label": "Choose initialization scenario",
      "execution": "user_input",
      "input_schema": {},
      "output_schema": {
        "type": "object",
        "properties": {
          "scenario": {
            "type": "string",
            "enum": [
              "from_code",
              "greenfield",
              "from_spec"
            ],
            "description": "from_code: existing codebase. greenfield: no code yet. from_spec: import from spec file."
          },
          "project_name": {
            "type": "string"
          },
          "project_path": {
            "type": "string"
          },
          "spec_path": {
            "type": "string"
          }
        },
        "required": [
          "scenario"
        ]
      },
      "on_success": "",
      "on_failure": "",
      "side_effects": [
        {
          "type": "capture_decision",
          "params": {}
        }
      ],
      "timeout_ms": 600000,
      "prompt_id": "project_init/scenario",
      "context": {
        "budget": {
          "max_tokens": 80000,
          "reserve_for_response": 10000,
          "strategy": "truncate"
        }
      }
    },
    {
      "key": "GATHER_SPECS",
      "label": "Gather project specifications",
      "execution": "llm_task",
      "input_schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Project name"
          },
          "language": {
            "type": "string",
            "description": "Primary language"
          },
          "framework": {
            "type": "string",
            "description": "Framework"
          },
          "description": {
            "type": "string",
            "description": "Project description"
          },
          "patterns": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Design patterns (DDD, hexagonal, MVC...)"
          },
          "bounded_contexts": {
            "type": "array",
            "description": "Bounded contexts"
          },
          "test_framework": {
            "type": "string"
          },
          "code_extensions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "naming_convention": {
            "type": "string"
          },
          "formatter": {
            "type": "string"
          },
          "linter": {
            "type": "string"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "specs": {
            "type": "object",
            "description": "Gathered specifications"
          }
        }
      },
      "on_success": "BUILD_PROJECT",
      "on_failure": "SCENARIO",
      "side_effects": [],
      "retry": {
        "max_attempts": 2,
        "backoff": "fixed",
        "initial_delay_ms": 1000
      },
      "timeout_ms": 600000,
      "prompt_id": "project_init/gather-specs",
      "context": {
        "sources": [
          {
            "provider": "project",
            "config": {}
          },
          {
            "provider": "state",
            "config": {
              "query": {}
            }
          }
        ],
        "focus": {
          "role": "gathering project specifications for initialization",
          "constraints": [
            "Use the PROJECT layer if available (project already initialized) or the STATE layer for detection results",
            "Ask targeted questions about project specs based on available context"
          ],
          "context_priority": "project → state"
        },
        "budget": {
          "max_tokens": 80000,
          "reserve_for_response": 10000,
          "strategy": "truncate"
        }
      }
    },
    {
      "key": "BUILD_PROJECT",
      "label": "Build project.json",
      "execution": "auto",
      "action": "build_project_config",
      "input_schema": {},
      "output_schema": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string"
          },
          "created": {
            "type": "boolean"
          }
        }
      },
      "on_success": "SCAN_CODE",
      "on_failure": "GATHER_SPECS",
      "side_effects": [],
      "timeout_ms": 30000,
      "prompt_id": "project_init/build-project",
      "context": {
        "budget": {
          "max_tokens": 80000,
          "reserve_for_response": 10000,
          "strategy": "truncate"
        }
      }
    },
    {
      "key": "SCAN_CODE",
      "label": "Scan code and build CPG",
      "execution": "auto",
      "action": "sync_code_index",
      "input_schema": {},
      "output_schema": {
        "type": "object",
        "properties": {
          "nodes": {
            "type": "integer"
          },
          "edges": {
            "type": "integer"
          },
          "files_scanned": {
            "type": "integer"
          }
        }
      },
      "on_success": "BUILD_CKG",
      "on_failure": "BUILD_CKG",
      "side_effects": [],
      "retry": {
        "max_attempts": 2,
        "backoff": "exponential",
        "initial_delay_ms": 2000
      },
      "timeout_ms": 120000,
      "prompt_id": "project_init/scan-code",
      "context": {
        "budget": {
          "max_tokens": 80000,
          "reserve_for_response": 10000,
          "strategy": "truncate"
        }
      }
    },
    {
      "key": "BUILD_CKG",
      "label": "Build initial knowledge graph",
      "execution": "auto",
      "action": "initialize_knowledge_base",
      "input_schema": {},
      "output_schema": {
        "type": "object",
        "properties": {
          "nodes_created": {
            "type": "integer"
          },
          "conventions": {
            "type": "integer"
          }
        }
      },
      "on_success": "REVIEW",
      "on_failure": "",
      "side_effects": [
        {
          "type": "documenting_knowledge",
          "params": {},
          "description": "Save initial CKG nodes"
        }
      ],
      "timeout_ms": 60000,
      "prompt_id": "project_init/build-ckg",
      "context": {
        "budget": {
          "max_tokens": 80000,
          "reserve_for_response": 10000,
          "strategy": "truncate"
        }
      }
    },
    {
      "key": "REVIEW",
      "label": "Review project configuration",
      "execution": "user_input",
      "input_schema": {
        "type": "object",
        "properties": {
          "intent": {
            "type": "string",
            "enum": [
              "project_ready",
              "revise_specs",
              "back_to_start"
            ]
          }
        },
        "required": [
          "intent"
        ]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "feedback": {
            "type": "string"
          }
        },
        "required": []
      },
      "on_success": "FIRST_SPRINT",
      "on_failure": "GATHER_SPECS",
      "side_effects": [
        {
          "type": "capture_decision",
          "params": {}
        }
      ],
      "timeout_ms": 600000,
      "prompt_id": "project_init/review",
      "context": {
        "budget": {
          "max_tokens": 80000,
          "reserve_for_response": 10000,
          "strategy": "truncate"
        }
      },
      "decision_field": "intent",
      "decision_map": {
        "project_ready": "project_ready",
        "revise_specs": "revise_specs",
        "back_to_start": "back_to_start"
      }
    },
    {
      "key": "FIRST_SPRINT",
      "label": "Create first sprint",
      "execution": "auto",
      "action": "create_first_sprint",
      "input_schema": {},
      "output_schema": {
        "type": "object",
        "properties": {
          "sprint_id": {
            "type": "string"
          },
          "created": {
            "type": "boolean"
          }
        }
      },
      "on_success": "",
      "on_failure": "REVIEW",
      "side_effects": [],
      "retry": {
        "max_attempts": 2,
        "backoff": "fixed",
        "initial_delay_ms": 1000
      },
      "timeout_ms": 30000,
      "prompt_id": "project_init/first-sprint",
      "context": {
        "budget": {
          "max_tokens": 80000,
          "reserve_for_response": 10000,
          "strategy": "truncate"
        }
      }
    }
  ]
}
