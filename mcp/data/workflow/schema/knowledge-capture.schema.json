{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema/knowledge-capture.schema.json",
  "title": "Knowledge Capture",
  "description": "Schema canonico de captura de conocimiento del workflow. Unifica los 4 schemas divergentes (ANALYZE.KNOWLEDGE_CAPTURE, IMPLEMENT.KNOWLEDGE_UPDATE, REFINE.KNOWLEDGE_CAPTURE, SPRINT.RETRO) en un solo modelo referenciado via $ref. Fija GAP-6.",
  "type": "object",
  "$defs": {
    "knowledge_item": {
      "type": "object",
      "description": "Item de conocimiento capturado (leccion, regla o patron).",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["lesson", "rule", "pattern", "decision", "warning"],
          "description": "Tipo de item de conocimiento"
        },
        "domain": {
          "type": "string",
          "description": "Dominio/feature al que aplica"
        },
        "statement": {
          "type": "string",
          "description": "Enunciado del conocimiento"
        },
        "rationale": {
          "type": "string",
          "description": "Razonamiento o justificacion"
        }
      },
      "required": ["type", "domain", "statement"]
    },
    "items": {
      "type": "array",
      "description": "Lista de items de conocimiento capturados",
      "items": {
        "$ref": "#/$defs/knowledge_item"
      }
    },
    "status": {
      "type": "object",
      "description": "Estado de la captura (envelope comun).",
      "properties": {
        "status": {
          "type": "string",
          "description": "Estado de la captura (captured/updated/completed)"
        },
        "count": {
          "type": "integer",
          "description": "Total de items capturados"
        },
        "items": {
          "$ref": "#/$defs/items"
        }
      }
    }
  },
  "properties": {
    "status": {
      "type": "string",
      "description": "Estado de la captura. Compatible con los 4 nodos."
    },
    "total_items": {
      "type": "integer",
      "description": "Total de items capturados (alias de count)."
    },
    "captured": {
      "type": "boolean",
      "description": "true si el conocimiento fue capturado."
    },
    "items": {
      "$ref": "#/$defs/items"
    },
    "count": {
      "type": "integer",
      "description": "Total de items (alias de total_items)."
    },
    "items_count": {
      "type": "integer",
      "description": "Total de items (alias de total_items)."
    },
    "total": {
      "type": "integer",
      "description": "Total de items (alias de total_items)."
    }
  },
  "anyOf": [
    {
      "required": ["status"]
    },
    {
      "required": ["captured"]
    },
    {
      "required": ["items"]
    }
  ],
  "description_suffix": "Los 4 sub-estados de knowledge capture referencian este canonico via $ref en su output_schema, eliminando los schemas inline divergentes."
}
