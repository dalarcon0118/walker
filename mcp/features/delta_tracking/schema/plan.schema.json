{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "delta/plan.schema.json",
  "title": "Delta Plan",
  "description": "Schema for delta plan.json — defines G_objetivo, predicates, and task decomposition. NO optional fields — if a field exists it must have a non-empty value.",
  "type": "object",
  "required": [
    "plan"
  ],
  "properties": {
    "plan": {
      "type": "object",
      "required": [
        "meta",
        "project",
        "goal",
        "tasks"
      ],
      "properties": {
        "meta": {
          "type": "object",
          "required": [
            "chain_id",
            "generated_at",
            "version",
            "source",
            "type"
          ],
          "properties": {
            "chain_id": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$",
              "minLength": 1
            },
            "generated_at": {
              "type": "string",
              "format": "date-time",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "type": "string",
              "enum": [
                "delta-skill"
              ]
            },
            "type": {
              "type": "string",
              "enum": [
                "plan"
              ]
            },
            "supersedes": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "project": {
          "type": "object",
          "required": [
            "project_id",
            "project_type",
            "domains",
            "tags"
          ],
          "properties": {
            "project_id": {
              "type": "string",
              "minLength": 1
            },
            "project_type": {
              "type": "string",
              "enum": [
                "backend",
                "frontend",
                "mobile",
                "fullstack",
                "library"
              ]
            },
            "domains": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "goal": {
          "type": "object",
          "required": [
            "description",
            "predicates"
          ],
          "properties": {
            "description": {
              "type": "string",
              "minLength": 10
            },
            "path_summary": {
              "type": "string"
            },
            "predicates": {
              "type": "object",
              "required": [
                "must_exist",
                "must_not_exist",
                "invariants"
              ],
              "properties": {
                "must_exist": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 3
                  }
                },
                "must_not_exist": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 3
                  }
                },
                "invariants": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 3
                  }
                }
              }
            },
            "signatures": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "function",
                  "file"
                ],
                "properties": {
                  "function": {
                    "type": "string",
                    "minLength": 1
                  },
                  "file": {
                    "type": "string",
                    "minLength": 1
                  },
                  "params": {
                    "type": "string",
                    "minLength": 1
                  },
                  "returns": {
                    "type": "string",
                    "minLength": 1
                  },
                  "change": {
                    "type": "string",
                    "minLength": 1
                  },
                  "replaces": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "done_when": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "criterio",
                  "predicates"
                ],
                "properties": {
                  "criterio": {
                    "type": "string",
                    "minLength": 1
                  },
                  "predicates": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  },
                  "satisfied": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/task"
          },
          "minItems": 1
        },
        "dependency_graph": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "parallel_opportunities": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "task_roles": {
          "type": "object",
          "properties": {
            "prerequisite": {
              "type": "string",
              "minLength": 1
            },
            "core": {
              "type": "string",
              "minLength": 1
            },
            "optional": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "required": [
        "task_id",
        "objective",
        "result_state",
        "type",
        "domain",
        "validation",
        "impacted_artifacts",
        "risks",
        "task_context",
        "role",
        "scrum_role",
        "work_type",
        "importer_files",
        "depends_on",
        "preconditions",
        "acceptance_criteria",
        "quality_gates",
        "loop_verification",
        "loop_acceptance",
        "decisions",
        "refinement",
        "task_description"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^TASK-[A-Z0-9-]+$"
        },
        "role": {
          "type": "string",
          "enum": [
            "prerequisite",
            "core",
            "optional"
          ]
        },
        "scrum_role": {
          "type": "string",
          "enum": [
            "po",
            "dev",
            "qa"
          ],
          "description": "Rol Scrum que activa/posee esta tarea. PO (define), Dev (implementa), QA (valida)."
        },
        "type": {
          "type": "string",
          "enum": [
            "feature",
            "bugfix",
            "refactor",
            "test",
            "docs",
            "optimization"
          ]
        },
        "work_type": {
          "type": "string",
          "enum": [
            "refactor_code_motion",
            "refactor",
            "feature_new_method",
            "feature_new_file",
            "feature_new_bc",
            "refactor_inline",
            "bugfix",
            "optimization",
            "docs"
          ]
        },
        "importer_files": {
          "type": "integer",
          "minimum": 0
        },
        "objective": {
          "type": "string",
          "minLength": 10
        },
        "result_state": {
          "type": "string",
          "minLength": 10
        },
        "domain": {
          "type": "string",
          "minLength": 2
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "quality_gates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "loop_verification": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "loop_acceptance": {
          "type": "string",
          "enum": [
            "all",
            "critical_only"
          ]
        },
        "impacted_artifacts": {
          "type": "object",
          "required": [
            "files"
          ],
          "properties": {
            "files": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "apis": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "data": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "config": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "tests": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "docs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "risks": {
          "type": "object",
          "required": [
            "curvature"
          ],
          "properties": {
            "curvature": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "pre_churn": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "commit_trust": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "chosen",
              "alternatives",
              "rationale"
            ],
            "properties": {
              "chosen": {
                "type": "string",
                "minLength": 1
              },
              "alternatives": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "refinement": {
          "type": "object",
          "properties": {
            "attempts": {
              "type": "integer",
              "minimum": 0
            },
            "dead_ends": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "task_context": {
          "type": "object",
          "required": [
            "observation",
            "structure",
            "behavior",
            "causality",
            "purpose",
            "principles"
          ],
          "properties": {
            "observation": {
              "type": "string",
              "minLength": 10,
              "description": "Capa 1: ¿Qué existe? Hechos, datos, síntomas del estado actual."
            },
            "structure": {
              "type": "string",
              "minLength": 10,
              "description": "Capa 2: ¿Cómo está organizado? Componentes, dependencias, interfaces."
            },
            "behavior": {
              "type": "string",
              "minLength": 10,
              "description": "Capa 3: ¿Cómo interactúa? Flujos, estados, secuencias, contratos."
            },
            "causality": {
              "type": "string",
              "minLength": 10,
              "description": "Capa 4: ¿Por qué ocurre? Restricciones, invariantes, causas raíz."
            },
            "purpose": {
              "type": "string",
              "minLength": 10,
              "description": "Capa 5: ¿Para qué existe? Objetivos, criterios de éxito, trade-offs."
            },
            "principles": {
              "type": "string",
              "minLength": 10,
              "description": "Capa 6: ¿Qué leyes generales gobiernan? Patrones reutilizables, heurísticas."
            }
          }
        },
        "validation": {
          "type": "object",
          "required": [
            "predicates"
          ],
          "properties": {
            "predicates": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 3
                  },
                  {
                    "type": "object",
                    "required": [
                      "type"
                    ],
                    "oneOf": [
                      {
                        "title": "symbol_exists",
                        "description": "Verifica que un símbolo exista en un archivo (ast-grep)",
                        "properties": {
                          "type": {
                            "enum": [
                              "symbol_exists"
                            ]
                          },
                          "symbol": {
                            "type": "string",
                            "minLength": 1
                          },
                          "file": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "type",
                          "symbol"
                        ]
                      },
                      {
                        "title": "symbol_not_exists",
                        "description": "Verifica que un símbolo NO exista (ast-grep)",
                        "properties": {
                          "type": {
                            "enum": [
                              "symbol_not_exists"
                            ]
                          },
                          "symbol": {
                            "type": "string",
                            "minLength": 1
                          },
                          "file": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "type",
                          "symbol"
                        ]
                      },
                      {
                        "title": "command_exit",
                        "description": "Ejecuta un comando y verifica exit code 0",
                        "properties": {
                          "type": {
                            "enum": [
                              "command_exit"
                            ]
                          },
                          "command": {
                            "type": "string",
                            "minLength": 3
                          }
                        },
                        "required": [
                          "type",
                          "command"
                        ]
                      },
                      {
                        "title": "command_output",
                        "description": "Ejecuta un comando y verifica que contenga texto",
                        "properties": {
                          "type": {
                            "enum": [
                              "command_output"
                            ]
                          },
                          "command": {
                            "type": "string",
                            "minLength": 3
                          },
                          "contains": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "type",
                          "command",
                          "contains"
                        ]
                      },
                      {
                        "title": "test_pass",
                        "description": "Ejecuta pytest o test y verifica exit code 0",
                        "properties": {
                          "type": {
                            "enum": [
                              "test_pass"
                            ]
                          },
                          "command": {
                            "type": "string",
                            "minLength": 3
                          }
                        },
                        "required": [
                          "type",
                          "command"
                        ]
                      }
                    ]
                  }
                ]
              },
              "minItems": 0
            }
          }
        },
        "task_description": {
          "type": "string",
          "minLength": 3,
          "description": "Descripcion corta de la tarea (1 linea)"
        }
      }
    }
  }
}