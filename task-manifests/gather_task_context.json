{
  "description": "Gather context for a specific task from CPG and CKG",
  "usage": "walker <project>/gather_task_context --task_id <id>",
  "tags": [
    "workflow",
    "context"
  ],
  "input_schema": {
    "required": [
      "task_id"
    ],
    "optional": [
      "files"
    ],
    "task_id": {
      "type": "string",
      "description": "Task ID",
      "example": "TASK-001"
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "data": {
        "type": "object",
        "description": "Task-specific context from CPG and CKG"
      }
    }
  }
}