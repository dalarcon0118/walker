{
  "description": "Prepare verification context from implementation for VERIFY node",
  "usage": "walker <project>/build_verification_context [--input <json>]",
  "tags": [
    "workflow",
    "transform"
  ],
  "input_schema": {
    "required": [],
    "optional": [
      "input",
      "output"
    ],
    "input": {
      "type": "object",
      "description": "Implementation data for verification"
    },
    "output": {
      "type": "object",
      "description": "Previous output (if any)"
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "data": {
        "type": "object",
        "properties": {
          "input": {
            "type": "object"
          },
          "output": {
            "type": "object"
          },
          "transformed": {
            "type": "boolean"
          }
        }
      }
    }
  }
}