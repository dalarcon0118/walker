{
  "description": "Scan project code and build/update the Code Property Graph (CPG)",
  "usage": "walker <project>/scan_code_and_build_cpg",
  "tags": [
    "workflow",
    "cpg"
  ],
  "input_schema": {
    "type": "object",
    "properties": {},
    "description": "No input required. Scans code from project root defined in chain_dir."
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "data": {
        "type": "object",
        "properties": {
          "nodes": {
            "type": "integer"
          },
          "files_scanned": {
            "type": "integer"
          },
          "cpg_path": {
            "type": "string"
          }
        }
      }
    }
  }
}