{
  "description": "Advance current_task_index to the next task in sprint-state.json",
  "usage": "walker <project>/advance_task_index",
  "tags": [
    "workflow",
    "internal"
  ],
  "input_schema": {
    "type": "object",
    "properties": {},
    "description": "No input required. Reads current_task_index from sprint-state.json and increments it."
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "data": {
        "type": "object",
        "properties": {
          "current_task_index": {
            "type": "integer"
          },
          "all_done": {
            "type": "boolean"
          }
        }
      }
    }
  }
}