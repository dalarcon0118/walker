{
  "description": "Implement a task: write code, modify files, run tests",
  "usage": "walker <project>/implement_task --task_id <id> --files <list>",
  "tags": [
    "workflow",
    "implementation"
  ],
  "input_schema": {
    "required": [
      "task_id"
    ],
    "optional": [
      "files",
      "test_command"
    ],
    "task_id": {
      "type": "string",
      "description": "Task ID to implement",
      "example": "TASK-001"
    },
    "files": {
      "type": "array",
      "description": "Files to implement/modify",
      "example": [
        "src/auth.py"
      ]
    },
    "test_command": {
      "type": "string",
      "description": "Test command to run after implementation",
      "example": "pytest tests/test_auth.py"
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "data": {
        "type": "object",
        "description": "Implementation result with files_changed and test_results"
      }
    }
  }
}