{
  "description": "Validate plan.json: check all tasks have required fields",
  "usage": "walker <project>/validate_plan",
  "tags": [
    "workflow",
    "validation"
  ],
  "input_schema": {
    "type": "object",
    "properties": {},
    "description": "No input required. Reads plan.json from sprint directory."
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "data": {
        "type": "object",
        "properties": {
          "valid": {
            "type": "boolean"
          },
          "errors": {
            "type": "array"
          },
          "task_count": {
            "type": "integer"
          },
          "specified_count": {
            "type": "integer"
          }
        }
      }
    }
  }
}