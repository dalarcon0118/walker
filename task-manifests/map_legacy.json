{
  "description": "Orchestrate mapping of legacy walker project to walker3 format",
  "tags": [
    "workflow",
    "project-init"
  ],
  "input_schema": {
    "required": [],
    "optional": [
      "is_legacy",
      "legacy_info"
    ],
    "is_legacy": {
      "type": "boolean",
      "description": "Whether the project is legacy. Auto-detected if omitted."
    },
    "legacy_info": {
      "type": "object",
      "description": "Legacy detection result from detect_project_context."
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "data": {
        "type": "object",
        "properties": {
          "legacy_mapped": {
            "type": "boolean"
          },
          "prompts_created": {
            "type": "integer"
          },
          "events_imported": {
            "type": "integer"
          },
          "tasks_converted": {
            "type": "integer"
          }
        }
      }
    }
  }
}