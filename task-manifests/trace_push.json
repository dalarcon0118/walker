{
  "description": "Register a trace event in the TraceGraph for agent activity tracking",
  "usage": "walker <project>/trace_push --event_type <type> [--source <src>] [--input <json>] [--output <json>]",
  "tags": [
    "workflow",
    "trace",
    "public"
  ],
  "input_schema": {
    "required": [],
    "optional": [
      "event_type",
      "source",
      "input",
      "output",
      "files",
      "task_id",
      "sprint_id",
      "node",
      "sub_state",
      "duration_ms",
      "metadata"
    ],
    "event_type": {
      "type": "string",
      "description": "Event type: agent_message, tool_call, file_impact, kg_query, task_execute",
      "example": "agent_message"
    },
    "source": {
      "type": "string",
      "description": "Event source: agent_hook, walker_task, workflow",
      "example": "agent_hook"
    },
    "input": {
      "type": "object",
      "description": "Input data (JSON object or string)",
      "example": {
        "message": "Hello"
      }
    },
    "output": {
      "type": "object",
      "description": "Output data (JSON object or string)"
    },
    "files": {
      "type": "array",
      "description": "Files impacted",
      "example": [
        "src/main.py"
      ]
    },
    "task_id": {
      "type": "string",
      "description": "Task ID",
      "example": "TASK-001"
    },
    "sprint_id": {
      "type": "string",
      "description": "Sprint ID"
    },
    "node": {
      "type": "string",
      "description": "Workflow node"
    },
    "sub_state": {
      "type": "string",
      "description": "Sub-state within node"
    },
    "duration_ms": {
      "type": "integer",
      "description": "Duration in ms",
      "example": 1500
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata"
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "data": {
        "type": "object",
        "properties": {
          "event_id": {
            "type": "string"
          },
          "event_type": {
            "type": "string"
          }
        }
      }
    }
  }
}