{
  "description": "Save knowledge nodes to the CKG (Code Knowledge Graph)",
  "usage": "walker <project>/save_to_ckg [--task_id <id>] [--label <text>] [--description <text>] [--type <type>]",
  "tags": [
    "workflow",
    "knowledge"
  ],
  "input_schema": {
    "required": [],
    "optional": [
      "task_id",
      "label",
      "description",
      "type",
      "nodes"
    ],
    "task_id": {
      "type": "string",
      "description": "Task ID",
      "example": "TASK-001"
    },
    "label": {
      "type": "string",
      "description": "Label for a single knowledge node"
    },
    "description": {
      "type": "string",
      "description": "Description for a single knowledge node"
    },
    "type": {
      "type": "string",
      "description": "Node type: decision, convention, warning",
      "example": "decision"
    },
    "nodes": {
      "type": "array",
      "description": "Array of node objects with label, description, type, metadata"
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "data": {
        "type": "object"
      }
    }
  }
}