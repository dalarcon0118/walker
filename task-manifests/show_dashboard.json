{
  "description": "Show sprint dashboard with task status summary",
  "usage": "walker <project>/show_dashboard [--goal <desc>] [--task_count <n>]",
  "tags": [
    "workflow",
    "sprint"
  ],
  "input_schema": {
    "required": [],
    "optional": [
      "goal",
      "task_count",
      "completed_count"
    ],
    "goal": {
      "type": "string",
      "description": "Sprint goal",
      "example": "Implement X"
    },
    "task_count": {
      "type": "integer",
      "description": "Total tasks"
    },
    "completed_count": {
      "type": "integer",
      "description": "Completed tasks"
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "data": {
        "type": "object",
        "properties": {
          "sprint_id": {
            "type": "string"
          },
          "goal": {
            "type": "string"
          },
          "task_count": {
            "type": "integer"
          },
          "completed_count": {
            "type": "integer"
          }
        }
      }
    }
  }
}