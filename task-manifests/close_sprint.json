{
  "description": "Close a sprint: mark as completed and archive",
  "usage": "walker <project>/close_sprint [--task_id <id>]",
  "tags": [
    "workflow",
    "sprint"
  ],
  "input_schema": {
    "required": [],
    "optional": [
      "task_id"
    ],
    "task_id": {
      "type": "string",
      "description": "Task ID to close",
      "example": "TASK-001"
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "data": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      }
    }
  }
}