{
  "description": "Plan a sprint: create plan.json with goal, predicates, and tasks",
  "usage": "walker <project>/plan_sprint --goal <desc> --predicates <json> --tasks <json>",
  "tags": [
    "workflow",
    "sprint"
  ],
  "input_schema": {
    "required": [
      "goal"
    ],
    "optional": [
      "task_count",
      "predicates",
      "tasks",
      "domains",
      "task_action"
    ],
    "goal": {
      "type": "string",
      "description": "Sprint goal description",
      "example": "Implement user authentication module"
    },
    "task_count": {
      "type": "integer",
      "description": "Number of tasks to create",
      "example": 5
    },
    "domains": {
      "type": "array",
      "description": "Domains involved",
      "example": [
        "core",
        "security"
      ]
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "data": {
        "type": "object",
        "properties": {
          "sprint_id": {
            "type": "string"
          },
          "task_count": {
            "type": "integer"
          }
        }
      }
    }
  }
}