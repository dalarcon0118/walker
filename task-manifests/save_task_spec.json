{
  "description": "Save complete task specification with all 22 fields to plan.json",
  "usage": "walker <project>/save_task_spec --task_id <id> --objective <title> --result_state <desc>",
  "tags": ["workflow", "planning"],
  "input_schema": {
    "required": [],
    "optional": ["task_id", "objective", "result_state", "task_description", "type", "domain", "predicates", "files", "depends_on", "curvature", "pre_churn", "commit_trust", "preconditions", "acceptance_criteria", "quality_gates", "task_context", "decisions", "loop_verification", "loop_acceptance"],
    "task_id": {"type": "string", "description": "Task ID (TASK-001, etc.)", "example": "TASK-001"},
    "objective": {"type": "string", "description": "Title or short objective", "example": "Create JackpotConfig model"},
    "result_state": {"type": "string", "description": "Expected result after completion", "example": "JackpotConfig class created"},
    "task_description": {"type": "string", "description": "Detailed description of the task"},
    "type": {"type": "string", "description": "feature | bugfix | refactor | chore | docs", "example": "feature"},
    "domain": {"type": "string", "description": "Domain or bounded context", "example": "game"}
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {"type": "boolean"},
      "data": {"type": "object", "properties": {
        "task_id": {"type": "string"},
        "saved": {"type": "boolean"},
        "task_index": {"type": "integer"},
        "next_task_index": {"type": "integer"}
      }}
    }
  }
}
