{
  "description": "Escalate refinement to sprint when limit reached (3 attempts)",
  "usage": "walker <project>/escalate_refine [--task_id <id>] [--attempt <n>]",
  "tags": [
    "workflow",
    "refine"
  ],
  "input_schema": {
    "required": [],
    "optional": [
      "task_id",
      "attempt"
    ],
    "task_id": {
      "type": "string",
      "description": "Task ID",
      "example": "TASK-001"
    },
    "attempt": {
      "type": "integer",
      "description": "Number of attempts made",
      "example": 3
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "data": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "previous_attempts": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}