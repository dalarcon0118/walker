{
  "description": "Verify DoD predicates against current code state",
  "usage": "walker <project>/verify_predicates [--task_id <id>] [--predicates <list>]",
  "tags": ["workflow", "verification"],
  "input_schema": {
    "required": [],
    "optional": ["task_id", "predicates"],
    "task_id": {"type": "string", "description": "Task ID to verify predicates for", "example": "TASK-001"},
    "predicates": {
      "type": "array",
      "description": "List of predicate strings to verify against current code",
      "example": ["function reset_jackpot exists", "class JackpotConfig has attribute game_id"]
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {"type": "boolean"},
      "data": {"type": "object", "properties": {
        "task_id": {"type": "string"},
        "all_passed": {"type": "boolean"},
        "results": {"type": "array"},
        "failed_count": {"type": "integer"}
      }}
    }
  }
}
