#!/usr/bin/env python3
"""CLI entry point for walker (MCP server, stdio transport). No PYTHONPATH required.

Entry point para el servidor MCP de Walker (transporte stdio):

Usage:
    walker3
"""
import os
import sys

_SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
_WALKER_ROOT = os.path.dirname(_SCRIPT_DIR)  # bin/../ = walker root
if _WALKER_ROOT not in sys.path:
    sys.path.insert(0, _WALKER_ROOT)

from fast_mcp.main import main  # noqa: E402

if __name__ == "__main__":
    # `main()` decide: `<project>/<tool> <json>` ejecuta la tool; sin args
    # arranca el server MCP por stdio (contrato del plugin, ADR-WALKER-016).
    sys.exit(main())
