#!/usr/bin/env python3
"""MCP server entry point for walker. No PYTHONPATH required.

Usage:
    walker-mcp
"""
import os
import sys

_SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
_WALKER_ROOT = os.path.dirname(_SCRIPT_DIR)  # bin/../ = walker root
if _SCRIPT_DIR not in sys.path:
    sys.path.insert(0, _SCRIPT_DIR)
if _WALKER_ROOT not in sys.path:
    sys.path.insert(0, _WALKER_ROOT)

from protocols.mcp.mcp_adapter import serve_stdio

if __name__ == "__main__":
    sys.exit(serve_stdio())
