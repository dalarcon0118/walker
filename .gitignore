# Walker3 HTTP Proxy — Git ignore

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Docker volumes (runtime data, not committed)
.walker/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Environment
.env*

# ── Cognitive runtime data (generated, not committed) ─────────────
# Índices de conocimiento y caches
**/*.json.gz
**/.file_snapshot.json
**/change_detected.json

# Caches y reportes generados
**/dfg_cache.json
# Sesiones de agentes
.cognitive/sessions/
.cognitive/projects/*/data/spring/
.cognitive/projects/*/data/data/
.cognitive/docs/

# Backups de la canónica (runtime, snapshot v2/v3 pre/post migración)
.cognitive/backups/
.cognitive/projects/*/backups/

# ── SQLite runtime (canónica: .cognitive/projects/<id>/data/cognitive.sqlite3) ──
# Copias parásitas en root/ y data/ eliminadas (fail-fast ADR-063: una sola
# ubicación canónica). Ignore anclado a root para que no reaparezcan.
/cognitive.sqlite3*
/data/cognitive.sqlite3*
/data/workflow/
.cognitive/projects/*/data/cognitive.sqlite3*
**/cfg_calls_cache.json
**/quality_report.json
**/bug_proposals.json

# Lock files de escritura atómica (runtime del CognitiveGraph, se recrean al escribir)
**/*.json.gz.lock

# Sesiones de agentes
.cognitive/sessions/
.cognitive/projects/*/data/spring/
.cognitive/projects/*/data/data/
.cognitive/docs/
