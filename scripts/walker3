#!/usr/bin/env python3
"""CLI entry point for walker. No PYTHONPATH required.

Consume el walker como una ruta REST (request/response estándar):

Usage:
    walker <project>/status
    walker <project>/kg_search '{"text":"..."}'
    walker <project>/transition <gate>
    walker routes
"""
import os
import sys

_SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
_WALKER_ROOT = os.path.dirname(_SCRIPT_DIR)  # scripts/../ = walker root
if _SCRIPT_DIR not in sys.path:
    sys.path.insert(0, _SCRIPT_DIR)
if _WALKER_ROOT not in sys.path:
    sys.path.insert(0, _WALKER_ROOT)

from features.cli_interface import main

if __name__ == "__main__":
    sys.exit(main())
